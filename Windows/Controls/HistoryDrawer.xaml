<UserControl x:Class="FocusCapture.Windows.Controls.HistoryDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 本地按钮样式：屏蔽宿主窗口的隐式 Button 样式（悬停灰块/内边距），列表项观感由 ItemBorder 控制 -->
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 历史会话抽屉：默认 Width=0 收起，宿主窗口用 DoubleAnimation 控制展开/收起。
         列表项与宿主解耦：宿主只订阅 SessionSelected 事件，替换宿主/换弹出方式无需改动本控件。 -->
    <Border Background="#252525" BorderBrush="#3A3A3A" BorderThickness="0,0,1,0"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12,10" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
                <TextBlock Text="历史会话" FontSize="12" FontWeight="SemiBold" Foreground="#999999"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,6">
                <ItemsControl x:Name="SessionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,0,4" Padding="0" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0"
                                    Tag="{Binding}" Click="Item_Click">
                                <Border Padding="8,7" CornerRadius="4" Background="Transparent"
                                        x:Name="ItemBorder">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#777777"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ModeText}" FontSize="10"
                                                       Foreground="#7A9E7A" Margin="4,0,0,0"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="#CCCCCC"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Button.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#333333" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="ItemBorder"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="Transparent" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="暂无历史会话" FontSize="12"
                       Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
