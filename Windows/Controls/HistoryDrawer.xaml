<UserControl x:Class="FocusCapture.Windows.Controls.HistoryDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FocusCapture.Windows.Controls">

    <!-- 本地按钮样式：屏蔽宿主窗口的隐式 Button 样式（悬停灰块/内边距），列表项观感由 ItemBorder 控制 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <controls:NonEmptyToVisibilityConverter x:Key="EmptyToCollapsed"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 分组分区头 -->
        <DataTemplate DataType="{x:Type controls:GroupHeaderViewModel}">
            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#777777"
                       Margin="6,8,0,4"/>
        </DataTemplate>

        <!-- 会话条目 -->
        <DataTemplate DataType="{x:Type controls:HistoryItemViewModel}">
            <Button Margin="0,0,0,4" Padding="0" HorizontalContentAlignment="Stretch"
                    Background="Transparent" BorderThickness="0"
                    Tag="{Binding}" Click="Item_Click">
                <Border Padding="8,7" CornerRadius="4" Background="Transparent"
                        x:Name="ItemBorder"
                        MouseEnter="Item_MouseEnter" MouseLeave="Item_MouseLeave">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Visibility="{Binding BatchCheckVis}" VerticalAlignment="Center"
                                      Margin="0,0,6,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="📌" FontSize="10" Foreground="#E5B567" Margin="0,0,4,0"
                                           Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="#CCCCCC"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding GroupName}" FontSize="10"
                                       Foreground="#6A8CAF" Margin="4,0,0,0"
                                       Visibility="{Binding GroupName, Converter={StaticResource EmptyToCollapsed}}"/>
                            <Button Grid.Column="3" Content="⋮" FontSize="14" Padding="4,0,2,0"
                                    Style="{StaticResource MiniToolButton}"
                                    Visibility="{Binding MoreVis}"
                                    Tag="{Binding}" Click="More_Click"
                                    ToolTip="更多操作"/>
                        </Grid>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#777777"/>
                            <TextBlock Grid.Column="1" Text="{Binding ModeText}" FontSize="10"
                                       Foreground="#7A9E7A" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 历史会话抽屉：默认 Width=0 收起，宿主窗口用 DoubleAnimation 控制展开/收起。
         列表项操作经 ItemAction/BatchAction 事件抛给宿主（改字段/删除/导出等业务在宿主），
         分组分区（置顶区 → 各分组 → 未分组）由 Load() 组织，分组头与条目用隐式 DataTemplate 区分。
         2026-09-21：抽屉列纵贯到窗口底部，左下补圆角与窗口外框衔接。 -->
    <Border Background="#252525" BorderBrush="#3A3A3A" BorderThickness="0,0,1,0"
            CornerRadius="0,0,0,6"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 头部：标题 + 管理按钮区 -->
            <Border Grid.Row="0" Padding="12,10" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="历史会话" FontSize="12" FontWeight="SemiBold" Foreground="#999999"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnGroups" Content="分组" Style="{StaticResource MiniToolButton}"
                                ToolTip="分组管理（新建 / 重命名 / 删除）" Click="BtnGroups_Click"/>
                        <Button x:Name="BtnRecycleBin" Content="回收站" Style="{StaticResource MiniToolButton}"
                                ToolTip="会话回收站（恢复 / 彻底删除）" Click="BtnRecycleBin_Click"/>
                        <!-- 收起：面板+左箭头图标用 Path 绘制（不依赖字体字形） -->
                        <Button x:Name="BtnCollapse" Style="{StaticResource MiniToolButton}" Padding="4,3"
                                ToolTip="收起历史会话" Click="BtnCollapse_Click" Margin="2,0,0,0">
                            <Path Width="10" Height="10" Stretch="Uniform"
                                  Data="M 8,3 L 3,7.5 L 8,12 M 12,3 L 12,12"
                                  Stroke="#888888" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 批量操作条（多选模式时显示） -->
            <StackPanel x:Name="BatchBar" Grid.Row="1" Orientation="Horizontal" Margin="8,6"
                        Background="#2D2D2D" Visibility="Collapsed">
                <Button Content="全选" Style="{StaticResource MiniToolButton}" Click="BatchSelectAll_Click"/>
                <Button Content="删除" Style="{StaticResource MiniToolButton}" Click="BatchDelete_Click"/>
                <Button Content="分组" Style="{StaticResource MiniToolButton}" Click="BatchGroup_Click"/>
                <Button Content="导出" Style="{StaticResource MiniToolButton}" Click="BatchExport_Click"/>
                <Button Content="退出" Style="{StaticResource MiniToolButton}" Click="BatchExit_Click"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="6,6">
                <ItemsControl x:Name="SessionList"/>
            </ScrollViewer>

            <TextBlock x:Name="EmptyHint" Grid.Row="2" Text="暂无历史会话" FontSize="12"
                       Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
