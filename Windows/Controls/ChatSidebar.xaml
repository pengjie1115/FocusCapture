<UserControl x:Class="FocusCapture.Windows.Controls.ChatSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FocusCapture.Windows.Controls"
             FontFamily="Microsoft YaHei UI" FontSize="13"
             Background="#1E1E1E">
    <!-- AI 问答侧边栏（2026-09-23 重构，取代历史抽屉）。
         分区自上而下：新对话 / 新分组 →（收藏 · 各分组）→ 置顶 → 最近 → 用户区。
         数据由宿主经 Load() 注入；所有业务动作（改字段 / 删除 / 导出）抛事件给宿主执行 ——
         本控件不直接改会话文件，与旧抽屉保持同一条纪律。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 顶部两个入口 ── -->
        <StackPanel Grid.Row="0" Margin="10,10,10,4">
            <Button x:Name="BtnNewChat" Click="BtnNewChat_Click"
                    HorizontalContentAlignment="Left" Padding="10,7"
                    Background="#2A2A2A" Foreground="#E0E0E0"
                    BorderBrush="#3A3A3A" BorderThickness="1"
                    Cursor="Hand" ToolTip="开一个不属于任何分组的新对话">
                <TextBlock Text="＋  新对话"/>
            </Button>
            <Button x:Name="BtnNewGroup" Click="BtnNewGroup_Click"
                    HorizontalContentAlignment="Left" Padding="10,7" Margin="0,6,0,0"
                    Background="#2A2A2A" Foreground="#C8C8C8"
                    BorderBrush="#3A3A3A" BorderThickness="1"
                    Cursor="Hand" ToolTip="建一个带指令的分组（进分组后说的指令默认都对着它）">
                <TextBlock Text="＋  新分组"/>
            </Button>
        </StackPanel>

        <!-- ── 列表区（收藏 / 各分组 / 置顶 / 最近）── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,0,6,6">
            <ItemsControl x:Name="ListHost">
                <ItemsControl.Resources>
                    <!-- 纯分区标题（置顶 / 最近）-->
                    <DataTemplate DataType="{x:Type local:SidebarSectionHeader}">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="#7A7A7A" FontSize="11"
                                   Margin="8,12,8,4"/>
                    </DataTemplate>

                    <!-- 可点击的分组行（收藏也走这一支，靠 GroupId 区分）-->
                    <DataTemplate DataType="{x:Type local:SidebarGroupHeader}">
                        <Border x:Name="GroupRow" Background="Transparent" CornerRadius="4"
                                Padding="8,6" Margin="0,1" Cursor="Hand"
                                MouseLeftButtonUp="GroupRow_Click" Tag="{Binding}"
                                ToolTip="{Binding Tooltip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                           Foreground="#D0D0D0" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <!-- 三点：仅鼠标悬停时出现（2026-09-23，参照千问）-->
                                <Button x:Name="GroupMore" Grid.Column="1" Content="⋮"
                                        Width="20" Height="20" Padding="0"
                                        Background="Transparent" Foreground="#9A9A9A"
                                        BorderThickness="0" Cursor="Hand"
                                        Visibility="Collapsed"
                                        Tag="{Binding}" Click="GroupMore_Click"
                                        ToolTip="重命名 / 置顶 / 删除"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                <Setter TargetName="GroupRow" Property="Background" Value="#2E2E2E"/>
                                <Setter TargetName="GroupMore" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <!-- 收藏是系统保留分区：不能重命名 / 置顶 / 删除，干脆不给三点入口。
                                 放在悬停 Trigger 之后 —— 同一目标的同一属性，后定义者生效。 -->
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter TargetName="GroupMore" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                    <!-- 会话条目 -->
                    <DataTemplate DataType="{x:Type local:HistoryItemViewModel}">
                        <Border x:Name="SessionRow" Background="Transparent" CornerRadius="4"
                                Padding="8,5" Margin="0,1" Cursor="Hand"
                                MouseLeftButtonUp="SessionRow_Click" Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SessionTitle" Grid.Column="0"
                                           Text="{Binding Title}" Foreground="#C8C8C8"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="{Binding Preview}"/>
                                <!-- 最后聊天时间 / 日期（用户要求：每条会话后面带上）-->
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                                           Foreground="#6E6E6E" FontSize="11"
                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <!-- 会话的三点：重命名 / 置顶 / 收藏 / 分组到… / 导出 / 删除。
                                     换控件不能丢功能 —— 这些入口原先散在旧抽屉的菜单里。 -->
                                <Button x:Name="SessionMore" Grid.Column="2" Content="⋮"
                                        Width="20" Height="20" Padding="0" Margin="2,0,0,0"
                                        Background="Transparent" Foreground="#9A9A9A"
                                        BorderThickness="0" Cursor="Hand"
                                        Visibility="Collapsed"
                                        Tag="{Binding}" Click="SessionMore_Click"
                                        ToolTip="重命名 / 置顶 / 收藏 / 分组到… / 导出 / 删除"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                <Setter TargetName="SessionRow" Property="Background" Value="#2E2E2E"/>
                                <Setter TargetName="SessionMore" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── 底部用户区（头像 + 昵称）── -->
        <Border Grid.Row="2" BorderBrush="#2E2E2E" BorderThickness="0,1,0,0" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="26" Height="26">
                    <!-- 默认：昵称首字色块；设了头像则显示图片盖住它 -->
                    <Ellipse Fill="#3A4A6A"/>
                    <TextBlock x:Name="AvatarInitial" Text="" Foreground="#D8E0F0" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="AvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="UserNickname" Grid.Column="1" Margin="8,0,0,0"
                           Foreground="#B8B8B8" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
