<Window x:Class="FocusCapture.Windows.TodoSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办汇总"
        Width="360" Height="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Topmost="True">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="待办汇总"
                   Foreground="#E0E0E0" FontSize="15" FontWeight="Bold"
                   Margin="2,0,0,10"/>

        <!-- 空态 -->
        <TextBlock x:Name="EmptyText"
                   Grid.Row="1"
                   Text="没有待办事项"
                   Foreground="#888888" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="PendingHeaderText"
                           Text="待处理"
                           Foreground="#4CAF50" FontSize="13" FontWeight="Bold"
                           Margin="2,0,0,6"/>
                <StackPanel x:Name="PendingList"/>

                <TextBlock x:Name="ReadHeaderText"
                           Text="已暂缓"
                           Foreground="#E8A33D" FontSize="13" FontWeight="Bold"
                           Margin="2,10,0,6"/>
                <StackPanel x:Name="ReadList"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>