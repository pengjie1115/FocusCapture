<Window x:Class="FocusCapture.Windows.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="380" Height="140"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="8" Background="#1E1E1E"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#252525" CornerRadius="8,8,0,0">
                <Grid Margin="14,0">
                    <TextBlock Text="全局查找"
                               Foreground="#CCCCCC" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Content="×" FontSize="16"
                            Width="24" Height="24"
                            Background="Transparent"
                            Foreground="#888888"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 输入框 + 提示 -->
            <StackPanel Grid.Row="1" Margin="16,16,16,8">
                <TextBlock x:Name="HintText"
                           Text="搜索全部笔记的内容/编辑内容/来源窗口（不区分大小写）"
                           Foreground="#888888" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBox x:Name="InputBox"
                         FontSize="13" Height="30"
                         Background="#2D2D2D"
                         Foreground="#E0E0E0"
                         BorderBrush="#555555" BorderThickness="1"
                         Padding="8,4"
                         CaretBrush="#4CAF50"
                         TextChanged="InputBox_TextChanged"/>
            </StackPanel>

            <!-- 按钮区 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="16,0,16,14">
                <Button Content="取消" Width="70" Height="28"
                        Background="#3A3A3A" Foreground="#AAAAAA"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnOk" Content="查找" Width="70" Height="28"
                        Background="#0078D4" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        IsEnabled="False"
                        Click="BtnOk_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
