<Window x:Class="FocusCapture.Windows.QuickViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusCapture.Windows"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="560" Height="450"
        Background="#1E1E1E"
        Opacity="0.80"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Border CornerRadius="8" Background="#1E1E1E"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部：标题栏 + 选择工具栏 -->
            <Border Grid.Row="0" Background="#252525" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题行 -->
                    <Grid Grid.Row="0" Margin="14,0"
                          MouseLeftButtonDown="TitleBar_MouseDown">
                        <TextBlock Text="今日灵感速览"
                                   Foreground="#CCCCCC"
                                   FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="DateText"
                                       Text=""
                                       Foreground="#666666"
                                       FontSize="12"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnExport"
                                    Content="▼ 导出"
                                    FontSize="11"
                                    Width="68" Height="24"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    BorderBrush="#555555"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Margin="0,0,6,0"
                                    Click="BtnExport_Click"/>
                            <Button x:Name="BtnClose"
                                    Content="×"
                                    FontSize="18"
                                    Width="28" Height="28"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 选择工具栏：全选/反选常驻，已选计数和删除按选中状态显隐 -->
                    <Border Grid.Row="1" Background="#1F1F1F"
                            x:Name="SelectionBar"
                            Padding="14,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedCountText"
                                       Text=""
                                       Foreground="#4CAF50"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Visibility="Collapsed"/>
                            <Button x:Name="BtnSelectAll"
                                    Content="全选"
                                    FontSize="11" Width="48" Height="24"
                                    Margin="0,0,4,0"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    BorderBrush="#555555" BorderThickness="1"
                                    Cursor="Hand"
                                    Click="BtnSelectAll_Click"/>
                            <Button x:Name="BtnInvert"
                                    Content="反选"
                                    FontSize="11" Width="48" Height="24"
                                    Margin="0,0,4,0"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    BorderBrush="#555555" BorderThickness="1"
                                    Cursor="Hand"
                                    Click="BtnInvert_Click"/>
                            <Button x:Name="BtnDeleteSelected"
                                    Content="删除已选"
                                    FontSize="11" Width="80" Height="24"
                                    Margin="0,0,4,0"
                                    Background="Transparent"
                                    Foreground="#E57373"
                                    BorderBrush="#E57373" BorderThickness="1"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="BtnDeleteSelected_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="NotesList" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#252525" CornerRadius="6"
                                    Margin="0,0,0,6" Padding="8,8,8,8"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="NoteItem_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Top"
                                              Margin="0,2,10,0"
                                              Cursor="Hand"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Foreground="#888888" FontSize="11"
                                                   Text="{Binding Timestamp, StringFormat=HH:mm}"/>
                                        <TextBlock Foreground="#E0E0E0" FontSize="13"
                                                   Text="{Binding FirstLine}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="40"/>
                                        <TextBlock Foreground="#555555" FontSize="11"
                                                   Text="{Binding SourceWindow}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding SourceWindow, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="×" FontSize="14"
                                            Width="22" Height="22" Padding="0"
                                            VerticalAlignment="Top"
                                            Margin="6,0,0,0"
                                            Background="Transparent"
                                            Foreground="#666666"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="BtnDeleteOne_Click"
                                            Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
