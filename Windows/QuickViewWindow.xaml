<Window x:Class="FocusCapture.Windows.QuickViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusCapture.Windows"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="560" Height="450"
        Background="#1E1E1E"
        Opacity="0.80"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <!-- 笔记条目右键菜单 -->
        <ContextMenu x:Key="NoteContextMenu"
                     Background="#2D2D2D"
                     Foreground="#E0E0E0"
                     Opened="NoteContextMenu_Opened">
            <MenuItem Header="AI 翻译" Click="CtxAiTranslate_Click"/>
            <MenuItem Header="AI 搜索" Click="CtxAiSearch_Click"/>
            <Separator/>
            <MenuItem Header="复制" Click="CtxCopy_Click"/>
            <MenuItem Header="编辑" Click="CtxEdit_Click"/>
            <MenuItem Header="删除" Click="CtxDelete_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Border CornerRadius="8" Background="#1E1E1E"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部：标题栏 + 选择工具栏 -->
            <Border Grid.Row="0" Background="#252525" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题行 -->
                    <Grid Grid.Row="0" Margin="14,0"
                          MouseLeftButtonDown="TitleBar_MouseDown">
                        <TextBlock Text="灵感速览"
                                   Foreground="#CCCCCC"
                                   FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <ComboBox x:Name="DaySelector"
                                      FontSize="11"
                                      MinWidth="150"
                                      Height="24"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      SelectionChanged="DaySelector_SelectionChanged"
                                      Foreground="White"
                                      Background="#252525"
                                      BorderBrush="#555555">
                                <ComboBox.Template>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid SnapsToDevicePixels="True">
                                            <Popup x:Name="PART_Popup"
                                                   Placement="Bottom"
                                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                                   AllowsTransparency="True"
                                                   Focusable="False"
                                                   PopupAnimation="Slide">
                                                <Border Background="#252525"
                                                        BorderBrush="#555555"
                                                        BorderThickness="1"
                                                        MinWidth="{TemplateBinding ActualWidth}"
                                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                        SnapsToDevicePixels="True">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="2">
                                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                            <ToggleButton x:Name="ToggleButton"
                                                          Focusable="False"
                                                          ClickMode="Press"
                                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="#252525"
                                                                BorderBrush="#555555"
                                                                BorderThickness="1"
                                                                CornerRadius="3">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Path Grid.Column="1"
                                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                                      Fill="#CCCCCC"
                                                                      Margin="0,0,7,0"
                                                                      VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <ContentPresenter x:Name="ContentSite"
                                                              IsHitTestVisible="False"
                                                              Content="{TemplateBinding SelectionBoxItem}"
                                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                              Margin="6,0,0,0"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Left"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ComboBox.Template>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#252525"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="6,3"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" Value="#3A3A3A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="White"
                                                   FontSize="11"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="DateText"
                                       Text=""
                                       Foreground="#666666"
                                       FontSize="12"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnExport"
                                    Content="▼ 导出"
                                    FontSize="11"
                                    Width="68" Height="24"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    BorderBrush="#555555"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Margin="0,0,6,0"
                                    Click="BtnExport_Click"/>
                            <Button x:Name="BtnAiAsk"
                                    Content="AI 问答"
                                    FontSize="11"
                                    Width="72" Height="24"
                                    Background="Transparent"
                                    Foreground="#4CAF50"
                                    BorderBrush="#4CAF50"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Margin="0,0,6,0"
                                    Click="BtnAiAsk_Click"/>
                            <Button x:Name="BtnClose"
                                    Content="×"
                                    FontSize="18"
                                    Width="28" Height="28"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 选择工具栏：全选/反选常驻，已选计数和删除按选中状态显隐 -->
                    <Border Grid.Row="1" Background="#1F1F1F"
                            x:Name="SelectionBar"
                            Padding="14,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedCountText"
                                       Text=""
                                       Foreground="#4CAF50"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Visibility="Collapsed"/>
                            <Button x:Name="BtnSelectAll"
                                    Content="全选"
                                    FontSize="11" Width="48" Height="24"
                                    Margin="0,0,4,0"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    BorderBrush="#555555" BorderThickness="1"
                                    Cursor="Hand"
                                    Click="BtnSelectAll_Click"/>
                            <Button x:Name="BtnInvert"
                                    Content="反选"
                                    FontSize="11" Width="48" Height="24"
                                    Margin="0,0,4,0"
                                    Background="Transparent"
                                    Foreground="#888888"
                                    BorderBrush="#555555" BorderThickness="1"
                                    Cursor="Hand"
                                    Click="BtnInvert_Click"/>
                            <Button x:Name="BtnDeleteSelected"
                                    Content="删除已选"
                                    FontSize="11" Width="80" Height="24"
                                    Margin="0,0,4,0"
                                    Background="Transparent"
                                    Foreground="#E57373"
                                    BorderBrush="#E57373" BorderThickness="1"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="BtnDeleteSelected_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 列表 -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="NotesList" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252525" CornerRadius="6"
                                        Margin="0,0,0,6" Padding="8,8,8,8"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="NoteItem_Click"
                                        ContextMenu="{StaticResource NoteContextMenu}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,10,0"
                                                  Cursor="Hand"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Foreground="#888888" FontSize="11"
                                                       Text="{Binding Timestamp, StringFormat=HH:mm}"/>
                                            <!-- 等高设计：内容区固定 52px，单行截断预览（NoWrap），双击编辑不撑高列表 -->
                                            <TextBlock Foreground="#E0E0E0" FontSize="13"
                                                       Text="{Binding FirstLine}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Height="52"
                                                       VerticalAlignment="Top"/>
                                            <TextBlock Foreground="#555555" FontSize="11"
                                                       Text="{Binding SourceWindow}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding SourceWindow, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <!-- 编辑态：内容区 TextBox 固定 52px（与非编辑态等高，列表零跳动），内部滚动看全文 -->
                                        <Grid Grid.Column="1">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Foreground="#888888" FontSize="11"
                                                       Text="{Binding Timestamp, StringFormat=HH:mm}"/>
                                            <TextBox Grid.Row="1" x:Name="EditBox"
                                                     Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Height="52"
                                                     BorderThickness="0"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Background="#2D2D2D"
                                                     Foreground="#E0E0E0"
                                                     Padding="6,4"
                                                     Cursor="IBeam"/>
                                            <TextBlock Grid.Row="2" Foreground="#555555" FontSize="11"
                                                       Text="{Binding SourceWindow}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding SourceWindow, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        </Grid>
                                        <!-- 右侧按钮区：全屏（常驻）+ 删除（常驻）+ 保存/取消（仅编辑态） -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="6,0,0,0">
                                            <Button Content="⛶" FontSize="13" Width="22" Height="22" Padding="0"
                                                    VerticalAlignment="Top"
                                                    Background="Transparent" Foreground="#888888"
                                                    BorderThickness="0"
                                                    ToolTip="全屏编辑"
                                                    Cursor="Hand"
                                                    Click="BtnFullEdit_Click"
                                                    Tag="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="×" FontSize="14" Width="22" Height="22" Padding="0"
                                                    Margin="0,2,0,0"
                                                    Background="Transparent"
                                                    Foreground="#666666"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="BtnDeleteOne_Click"
                                                    Tag="{Binding}"/>
                                            <StackPanel Margin="0,6,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="保存" FontSize="11" Height="24" Padding="10,0"
                                                        Margin="0,0,0,4"
                                                        Background="#3A3A3A" Foreground="#4CAF50"
                                                        BorderBrush="#4CAF50" BorderThickness="1"
                                                        Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="BtnEditSave_Click"/>
                                                <Button Content="取消" FontSize="11" Height="24" Padding="10,0"
                                                        Background="#3A3A3A" Foreground="#CCCCCC"
                                                        BorderBrush="#555555" BorderThickness="1"
                                                        Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="BtnEditCancel_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyHint"
                           Text="这一天还没有笔记"
                           Foreground="#666666"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- 编辑态浮动工具条：选中文字约 400ms 后出现 -->
            <Border x:Name="FloatToolbar"
                    Background="#2D2D2D"
                    BorderBrush="#4CAF50"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,4"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Panel.ZIndex="99">
                <StackPanel Orientation="Horizontal">
                    <Button Content="翻译" FontSize="11" Height="22" Padding="8,0"
                            Margin="0,0,4,0"
                            Background="#3A3A3A" Foreground="#E0E0E0"
                            BorderBrush="#555555" BorderThickness="1"
                            Cursor="Hand"
                            Tag="Translate"
                            Click="FloatToolbar_Click"/>
                    <Button Content="搜索" FontSize="11" Height="22" Padding="8,0"
                            Margin="0,0,4,0"
                            Background="#3A3A3A" Foreground="#E0E0E0"
                            BorderBrush="#555555" BorderThickness="1"
                            Cursor="Hand"
                            Tag="Search"
                            Click="FloatToolbar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
