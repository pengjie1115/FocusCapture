<Window x:Class="FocusCapture.Windows.RecycleBinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="520" Height="460"
        Background="#1E1E1E"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="8" Background="#1E1E1E"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#252525" CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="回收站" Foreground="#CCCCCC"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <Button Content="✕" FontSize="12"
                            Width="28" Height="24"
                            Background="Transparent" Foreground="#CCCCCC"
                            BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 列表 -->
            <ListBox x:Name="RecycleList" Grid.Row="1"
                     Background="Transparent" BorderThickness="0"
                     Margin="10,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="RecycleList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="6" Margin="0,2" Padding="0">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3A503A"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2F2F2F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2A2A2A" CornerRadius="6" Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="{Binding Preview}"
                                           Foreground="#E0E0E0" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Foreground="#777777" FontSize="10" Margin="0,5,0,0">
                                    <Run Text="删除于 "/><Run Text="{Binding DeletedAt, StringFormat=yyyy-MM-dd HH:mm}"/>
                                    <Run Text=" · 过期于 "/><Run Text="{Binding ExpiresAt, StringFormat=yyyy-MM-dd}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空提示 -->
            <TextBlock x:Name="EmptyHint" Grid.Row="1"
                       Text="回收站是空的"
                       Foreground="#666666" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        Margin="12,0,12,14" HorizontalAlignment="Right">
                <Button x:Name="BtnRestore" Content="恢复所选"
                        Height="30" Padding="16,0"
                        Background="#3A3A3A" Foreground="#CCCCCC"
                        BorderThickness="0" Cursor="Hand"
                        IsEnabled="False"
                        Click="BtnRestore_Click"/>
                <Button x:Name="BtnPurge" Content="清空回收站"
                        Height="30" Padding="16,0" Margin="8,0,0,0"
                        Background="#3A3A3A" Foreground="#E57373"
                        BorderThickness="0" Cursor="Hand"
                        IsEnabled="False"
                        Click="BtnPurge_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
