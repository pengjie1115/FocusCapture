<Window x:Class="FocusCapture.Windows.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="600" Height="80"
        Background="#1E1E1E"
        Opacity="0.80"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <DropShadowEffect x:Key="BoxShadow" BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
    </Window.Resources>

    <Border CornerRadius="10" Background="#1E1E1E"
            Effect="{StaticResource BoxShadow}"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputBox"
                     Grid.Column="0"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#E0E0E0"
                     CaretBrush="#4CAF50"
                     FontSize="15"
                     FontFamily="Microsoft YaHei UI"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     MaxHeight="150"
                     PreviewKeyDown="InputBox_PreviewKeyDown"
                     TextChanged="InputBox_TextChanged"
                     SpellCheck.IsEnabled="False"
                     Padding="4,2">
                <TextBox.Resources>
                    <Style TargetType="{x:Type ScrollViewer}">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- 语音输入：复用 VoiceService，与沉浸式输入互斥 -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Margin="10,0,0,0">
                <TextBlock x:Name="VoiceHintText"
                           Text=""
                           Foreground="#888888"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <Button x:Name="BtnMic"
                        Content="🎤"
                        Width="34" Height="34"
                        FontSize="15"
                        Background="#3A3A3A"
                        Foreground="#CCCCCC"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="语音输入"
                        Click="BtnMic_Click"/>
            </StackPanel>

            <TextBlock x:Name="Placeholder"
                       Grid.Column="0"
                       Text="记录你的灵感…（回车保存，Esc 取消）"
                       Foreground="#666666"
                       FontSize="12"
                       FontFamily="Microsoft YaHei UI"
                       IsHitTestVisible="False"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Left"
                       Margin="4,0,0,6"/>
        </Grid>
    </Border>
</Window>
