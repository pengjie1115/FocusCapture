<Window x:Class="FocusCapture.Windows.AIDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FocusCapture.Windows.Controls"
        Title="AI 问答"
        Width="640" Height="560"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 2026-09-21：滚动条样式上收到 App.xaml 全局隐式样式（原窗口内的 ScrollbarStyle 只定义未引用，已删） -->
    </Window.Resources>

    <Border CornerRadius="6" Background="#1E1E1E"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（底部 2px 品牌绿 accent 线，配色方案 B 的标志） -->
            <Border Grid.Row="0" Background="#252525" CornerRadius="6,6,0,0"
                    BorderBrush="#4CAF50" BorderThickness="0,0,0,2">
                <Grid Margin="14,0">
                    <TextBlock x:Name="TitleText"
                               Text="AI 问答"
                               Foreground="#CCCCCC"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnHistory"
                                Content="历史"
                                FontSize="12"
                                Height="26"
                                Padding="10,0"
                                Margin="0,0,6,0"
                                Background="Transparent"
                                Foreground="#888888"
                                BorderThickness="0"
                                Click="BtnHistory_Click"/>
                        <Button x:Name="BtnNewSession"
                                Content="+ 新会话"
                                FontSize="12"
                                Height="26"
                                Padding="10,0"
                                Margin="0,0,6,0"
                                Background="Transparent"
                                Foreground="#888888"
                                BorderThickness="0"
                                Click="BtnNewSession_Click"/>
                        <!-- 2026-09-21：窗口内关闭按钮已删 —— 全局按钮样式的 Padding(12,5) 把 28×28 按钮里的
                             "×"字形裁成一条竖缝，看着像两个点（用户反馈）。关窗走原生标题栏 ×。 -->
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 消息列表 + 侧边栏（列 Auto 跟随 Sidebar.Width，宽度动画/拖拽都作用于 Sidebar.Width——
                 WPF GridLength 无 DoubleAnimation，铁律：不动画/拖拽 ColumnDefinition）。
                 拖拽用 Thumb（GridSplitter 基类，样式照搬 SettingsWindow 的 splitter）：其自动 resize 只能改列宽，
                 与"只改 Sidebar.Width"铁律冲突，故 DragDelta 手动改控件宽度。 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:ChatSidebar x:Name="Sidebar" Grid.Column="0" Width="0"/>
                <Thumb x:Name="DrawerSplitter" Grid.Column="1" Width="5" Margin="0,0"
                       Cursor="SizeWE" DragDelta="DrawerSplitter_DragDelta" DragCompleted="DrawerSplitter_DragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent">
                                <Rectangle Width="1" HorizontalAlignment="Center" Fill="#3A3A3A"/>
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>

                <!-- 2026-09-21 重排：对话列（消息区 + 输入区）收进第三列 —— 历史抽屉列纵贯全窗，
                     输入区与对话区同宽，拖抽屉时输入区实时跟随（用户要求"分区管理"）。
                     原结构：消息区在 Row1 的第三列、输入区横贯整窗底部（Row2）。 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 分组视图（2026-09-23）：点侧边栏的分组进来。与消息区同占 Row 0，用 Visibility 互斥 ——
                         不新增行，输入区原地不动（在分组里输入 = 在该分组下新建会话）。 -->
                    <Grid x:Name="GroupViewPanel" Grid.Row="0" Visibility="Collapsed" Background="#1E1E1E">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 工具行：分组名 + 添加指令 / 编辑分组名 / 删除分组 / 返回对话 -->
                        <WrapPanel Grid.Row="0" Margin="14,12,14,4">
                            <TextBlock x:Name="GroupViewTitle" FontSize="15" Foreground="#E8E8E8"
                                       VerticalAlignment="Center" Margin="0,0,14,4"/>
                            <Button x:Name="BtnGroupInstruction" Content="添加指令" Click="BtnGroupInstruction_Click"
                                    Padding="8,3" Margin="0,0,6,4" FontSize="12" Cursor="Hand"
                                    Background="#2A2A2A" Foreground="#C8C8C8" BorderBrush="#3A3A3A" BorderThickness="1"/>
                            <Button x:Name="BtnGroupRename" Content="编辑分组名" Click="BtnGroupRename_Click"
                                    Padding="8,3" Margin="0,0,6,4" FontSize="12" Cursor="Hand"
                                    Background="#2A2A2A" Foreground="#C8C8C8" BorderBrush="#3A3A3A" BorderThickness="1"/>
                            <Button x:Name="BtnGroupDelete" Content="删除分组" Click="BtnGroupDelete_Click"
                                    Padding="8,3" Margin="0,0,6,4" FontSize="12" Cursor="Hand"
                                    Background="#2A2A2A" Foreground="#D08080" BorderBrush="#3A3A3A" BorderThickness="1"/>
                            <Button x:Name="BtnGroupViewClose" Content="返回对话" Click="BtnGroupViewClose_Click"
                                    Padding="8,3" Margin="0,0,0,4" FontSize="12" Cursor="Hand"
                                    Background="Transparent" Foreground="#7A9E7A" BorderThickness="0"/>
                        </WrapPanel>

                        <!-- 该分组当前的指令（只读展示；改要点上面的「添加指令」）-->
                        <TextBlock x:Name="GroupInstructionText" Grid.Row="1" Margin="14,0,14,8"
                                   Foreground="#8A8A8A" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                            <StackPanel>
                                <ItemsControl x:Name="GroupSessionList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" CornerRadius="4" Padding="8,6" Margin="0,1"
                                                    Cursor="Hand" MouseLeftButtonUp="GroupSessionRow_Click" Tag="{Binding}"
                                                    ToolTip="{Binding Preview}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#C8C8C8"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="#6E6E6E"
                                                               FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="GroupSessionEmptyHint"
                                           Text="这个分组还没有会话 —— 在下面输入框里说第一句，就会开始一个属于它的话题。"
                                           Foreground="#7A7A7A" FontSize="12" Margin="8,6,8,0"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 起手页（2026-09-23）：空会话时显示自定义欢迎语（图标 + 文字），
                         此刻输入区被摆到正中间（见 ApplyComposerLayout），发第一条消息后一起沉底。 -->
                    <Grid x:Name="WelcomePanel" Grid.Row="0" Visibility="Collapsed">
                        <!-- 底部 180 的留白是刻意的：输入区居中时中心也在 Row 0 的中心，
                             欢迎语靠这个偏移让出它头顶的位置，两者不会叠在一起。 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,180">
                            <Image x:Name="WelcomeIcon" Width="56" Height="56" Stretch="Uniform"
                                   HorizontalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="WelcomeText" FontSize="18" Foreground="#D8D8D8"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="420" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="MessagesScroll" Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="14,10">
                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <Border Background="#252525"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            MaxWidth="520"
                                            HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#252525"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Background" Value="#2A3A2A"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock x:Name="RoleLabel"
                                                       FontSize="10"
                                                       Foreground="#777777"
                                                       Margin="0,0,0,3"/>
                                            <!-- 思考过程：灰色斜体可折叠，仅思考型模型产生内容时显示 -->
                                            <Expander x:Name="ReasoningArea"
                                                      Header="思考过程"
                                                      FontSize="11"
                                                      Foreground="#888888"
                                                      IsExpanded="{Binding IsReasoningOpen, Mode=TwoWay}"
                                                      Margin="0,0,0,4">
                                                <Expander.Visibility>
                                                    <Binding Path="HasReasoning">
                                                        <Binding.Converter>
                                                            <BooleanToVisibilityConverter/>
                                                        </Binding.Converter>
                                                    </Binding>
                                                </Expander.Visibility>
                                                <TextBox Text="{Binding ReasoningText, Mode=OneWay}"
                                                         TextWrapping="Wrap"
                                                         IsReadOnly="True"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="#9E9E9E"
                                                         FontSize="11"
                                                         FontStyle="Italic"
                                                         Padding="0"
                                                         MaxHeight="180"
                                                         VerticalScrollBarVisibility="Auto"/>
                                            </Expander>
                                            <!-- Agent 工具调用步骤（过程记录，回答完成后保留） -->
                                            <TextBlock x:Name="ToolStepsText"
                                                       Text="{Binding ToolSteps}"
                                                       FontSize="10"
                                                       Foreground="#6E8B6E"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,4"
                                                       Visibility="{Binding HasToolSteps, Converter={StaticResource BoolToVis}}"/>
                                            <!-- 只读 TextBox：支持拖选部分文字回填（TextBlock 不支持选中） -->
                                            <TextBox x:Name="BubbleText"
                                                     Text="{Binding Content}"
                                                     TextWrapping="Wrap"
                                                     IsReadOnly="True"
                                                     IsReadOnlyCaretVisible="False"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="#E0E0E0"
                                                     FontSize="13"
                                                     Padding="0"/>
                                            <!-- 附件区（2026-09-14）：与输入区同一种卡片（图标前缀 + 截断文件名），
                                                 悬停出预览、双击看大图/打开原文件。刻意不复刻输入区里的精确交错顺序——
                                                 气泡正文是纯文本控件，顺序仍在会话数据里（InsertOffset），上行请求照旧还原 -->
                                            <ItemsControl x:Name="BubbleAttachments"
                                                          ItemsSource="{Binding Attachments}"
                                                          Margin="0,6,0,0"
                                                          Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="BubbleChip"
                                                                Background="#1E1E1E"
                                                                BorderBrush="#378ADD"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,1"
                                                                Margin="0,0,6,4"
                                                                Cursor="Hand"
                                                                VerticalAlignment="Center"
                                                                MouseEnter="AttachmentChip_MouseEnter"
                                                                MouseLeave="AttachmentChip_MouseLeave"
                                                                MouseLeftButtonDown="AttachmentChip_MouseDown">
                                                            <TextBlock Text="{Binding ChipText}"
                                                                       FontSize="12"
                                                                       Foreground="#CCCCCC"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                                <Setter TargetName="BubbleChip" Property="BorderBrush" Value="#888780"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                <Setter TargetName="BubbleChip" Property="BorderBrush" Value="#5A5A5A"/>
                                                                <Setter TargetName="BubbleChip" Property="Background" Value="#232323"/>
                                                                <Setter TargetName="BubbleChip" Property="Cursor" Value="Arrow"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- 云文件卡片（2026-09-16）：从网盘取回的文件落进对话，
                                                 卡片上给三个动作。取回后文件已在本机，所以「打开 / 定位」几乎零成本。 -->
                                            <ItemsControl x:Name="BubbleCloudFiles"
                                                          ItemsSource="{Binding CloudFiles}"
                                                          Margin="0,6,0,0"
                                                          Visibility="{Binding HasCloudFiles, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1E1E1E"
                                                                BorderBrush="#C9A227"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="8,3"
                                                                Margin="0,0,6,4"
                                                                VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}"
                                                                           FontSize="12"
                                                                           Foreground="#DDDDDD"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0"/>
                                                                <Button Content="打开"
                                                                        FontSize="11" Height="22" Padding="8,0" Margin="0,0,4,0"
                                                                        Background="#2D2D2D" Foreground="#4CAF50" BorderBrush="#4CAF50"
                                                                        Tag="{Binding}" Click="CloudFile_Open_Click"/>
                                                                <Button Content="定位"
                                                                        FontSize="11" Height="22" Padding="8,0" Margin="0,0,4,0"
                                                                        Background="#2D2D2D" Foreground="#AAAAAA" BorderBrush="#555555"
                                                                        Tag="{Binding}" Click="CloudFile_Locate_Click"/>
                                                                <Button Content="另存"
                                                                        FontSize="11" Height="22" Padding="8,0" Margin="0,0,4,0"
                                                                        Background="#2D2D2D" Foreground="#AAAAAA" BorderBrush="#555555"
                                                                        Tag="{Binding}" Click="CloudFile_SaveAs_Click"/>
                                                                <Button Content="彻底删除"
                                                                        FontSize="11" Height="22" Padding="8,0"
                                                                        Background="#2D2D2D" Foreground="#E08585" BorderBrush="#8A3A3A"
                                                                        ToolTip="从本机与网盘一起删除（网盘侧可在回收站找回）"
                                                                        Tag="{Binding}" Click="CloudFile_Delete_Click"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFillable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button x:Name="FillAppendButton"
                                                        Content="追加到原笔记"
                                                        FontSize="11"
                                                        Height="24"
                                                        Padding="10,0"
                                                        Margin="0,0,6,0"
                                                        HorizontalAlignment="Left"
                                                        Background="#2D2D2D"
                                                        Foreground="#4CAF50"
                                                        BorderBrush="#4CAF50"
                                                        Tag="{Binding}"
                                                        Click="BtnFillAppend_Click"/>
                                                <Button x:Name="FillNewButton"
                                                        Content="存为新笔记"
                                                        FontSize="11"
                                                        Height="24"
                                                        Padding="10,0"
                                                        HorizontalAlignment="Left"
                                                        Background="#2D2D2D"
                                                        Foreground="#888888"
                                                        BorderBrush="#555555"
                                                        Tag="{Binding}"
                                                        Click="BtnFillNew_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="RoleLabel" Property="Text" Value="我"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUser}" Value="False">
                                        <Setter TargetName="RoleLabel" Property="Text" Value="AI"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFilled}" Value="True">
                                        <Setter TargetName="FillAppendButton" Property="Content" Value="已回填"/>
                                        <Setter TargetName="FillAppendButton" Property="IsEnabled" Value="False"/>
                                        <Setter TargetName="FillNewButton" Property="Content" Value="已回填"/>
                                        <Setter TargetName="FillNewButton" Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 输入区（2026-09-14：支持图片/文档，文字与附件块混排）
                     结构：加号按钮 + 富文本输入区 + 发送按钮。
                     AllowDrop 设在本 Border 上（拖文件到输入区即添加；不设窗口级，避免与消息区滚动冲突）。
                     注意：输入框自身也要接受拖放 —— RichTextBox 内置了文本拖放处理，会先把拖拽事件标记为
                     已处理，只有显式接管（见 InitInputArea）才能在框内正上方生效。
                     2026-09-21 重排：从窗口底行挪进对话列（Row1），宽度跟随历史抽屉联动。
                     左下圆角由代码按抽屉开合切换（InputAreaCornerRadius）。 -->
                <Border x:Name="InputArea" Grid.Row="1" Background="#252525" CornerRadius="0,0,6,6" Padding="12,10"
                        AllowDrop="True" DragOver="InputArea_DragOver" Drop="InputArea_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 已选择的本地文件（2026-09-16，红线）：
                         用户点「选择文件」后这里出现一张牌号卡片，AI 只能引用卡片上的牌号（file:yyyyMMdd-N）。
                         路径永远不进模型 —— 模型编不出牌号，也就碰不到没被点过的文件。
                         刻意与下方附件卡片区分配色（金黄描边）：附件是要发给模型的内容，这里是「AI 可操作的本机文件」。 -->
                    <ItemsControl x:Name="HandleChips" Grid.Row="0" Margin="0,0,0,6"
                                  Visibility="{Binding HasHandles, ElementName=Self_HandleHost, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 2026-09-21：MaxWidth 卡住卡片上限 —— 长文件名此前会把"×"挤出窗口
                                     （WrapPanel 无法从中间折断一张卡片）。文件名用省略号截断，全名悬停可见。 -->
                                <Border Background="#2A2A1E"
                                        BorderBrush="#C9A227"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        MaxWidth="320"
                                        Margin="0,0,6,4"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        ToolTip="{Binding Path}"
                                        MouseLeftButtonDown="HandleChip_MouseDown">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="本机文件"
                                                   FontSize="10"
                                                   Foreground="#C9A227"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="12"
                                                   Foreground="#DDDDDD"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Id}"
                                                   FontSize="10"
                                                   Foreground="#8A8A8A"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                        <TextBlock Text="×"
                                                   FontSize="13"
                                                   Foreground="#999999"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Cursor="Hand"
                                                   ToolTip="取消选择该文件"
                                                   Tag="{Binding Id}"
                                                   MouseLeftButtonUp="HandleChipRemove_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Bottom">
                    <!-- 加号：打开文件选择框。Padding=0 必须显式设置——全局 Button 样式是 8,4，会挤偏图标。
                         图标用矢量 Path 而非 "+" 字符：字体里的加号字形在行框内本身不居中，
                         无论怎么调字号/内边距都消不掉那点偏差，矢量图形才能真居中。 -->
                    <!-- 输入区左侧唯一的加号（2026-09-23）：点开弹两项 —— 添加附件 / 引用文件。
                         原先这里是并排两个按钮，用户要求"打开时只出现一个加号"。
                         两项语义仍严格区分：附件是发给模型看的；引用文件只给 AI 一个牌号，路径不进模型。 -->
                    <Button x:Name="BtnAttach"
                            Width="30" Height="36"
                            Padding="0"
                            Background="#1E1E1E"
                            Foreground="#AAAAAA"
                            BorderBrush="#555555"
                            ToolTip="添加附件（发给 AI 看）或引用文件（让 AI 操作）。也可直接 Ctrl+V 粘贴、或把文件拖进来"
                            Click="BtnAttach_Click">
                        <Path Data="M0,6 H12 M6,0 V12"
                              Stroke="#BBBBBB"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                    </StackPanel>

                    <!-- 富文本输入区：文字与附件块混排。
                         MaxHeight 放在外框上，内部 ScrollViewer 管滚动 —— 输入区随内容长高，到上限后内部滚动。
                         2026-09-21：MinHeight 压到 22（外框约 36px = 原来的 2/3，用户拍板），
                         两侧按钮与外框等高；圆角 4→8。 -->
                    <Border Grid.Column="1"
                            Background="#1E1E1E"
                            BorderBrush="#555555"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,6"
                            MaxHeight="160">
                        <Grid>
                            <ScrollViewer x:Name="InputScroll" VerticalScrollBarVisibility="Auto">
                                <RichTextBox x:Name="InputBox"
                                             MinHeight="22"
                                             Background="Transparent"
                                             Foreground="#E0E0E0"
                                             CaretBrush="#E0E0E0"
                                             SelectionBrush="#3A5A8A"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontSize="13"
                                             AcceptsReturn="True"
                                             IsDocumentEnabled="True"
                                             AllowDrop="True"
                                             VerticalScrollBarVisibility="Disabled"
                                             PreviewKeyDown="InputBox_PreviewKeyDown"/>
                            </ScrollViewer>
                            <!-- 占位提示：输入区加高后空白区域需要一句引导，否则像个坏掉的框 -->
                            <TextBlock x:Name="InputPlaceholder"
                                       Text="输入问题，Ctrl+V 可粘贴图片，或把文件拖进来"
                                       Foreground="#7A7A7A"
                                       FontSize="13"
                                       VerticalAlignment="Top"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- 发送按钮（2026-09-23）：文字「发送」改图标箭头（用户要求）。
                         生成中换成方块（停止）—— 行为一个字没变，只换外形。 -->
                    <Button x:Name="BtnSend"
                            Grid.Column="2"
                            Width="36" Height="36"
                            Padding="0"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            Background="#3A3A3A"
                            BorderBrush="#4CAF50"
                            BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="发送（Enter）"
                            Click="BtnSend_Click">
                        <Grid>
                            <Path x:Name="SendIcon" Data="M2,7 L13,7 M8.5,2.5 L13,7 L8.5,11.5"
                                  Stroke="#4CAF50" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path x:Name="StopIcon" Data="M4,4 H12 V12 H4 Z" Fill="#4CAF50" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                </Grid>
                </Grid>
            </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
