<Window x:Class="FocusCapture.Windows.AIDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FocusCapture.Windows.Controls"
        Title="AI 问答"
        Width="640" Height="560"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScrollbarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Width" Value="8"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="6" Background="#1E1E1E"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#252525" CornerRadius="6,6,0,0">
                <Grid Margin="14,0">
                    <TextBlock x:Name="TitleText"
                               Text="AI 问答"
                               Foreground="#CCCCCC"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnHistory"
                                Content="历史"
                                FontSize="12"
                                Height="26"
                                Padding="10,0"
                                Margin="0,0,6,0"
                                Background="Transparent"
                                Foreground="#888888"
                                BorderThickness="0"
                                Click="BtnHistory_Click"/>
                        <Button x:Name="BtnNewSession"
                                Content="+ 新会话"
                                FontSize="12"
                                Height="26"
                                Padding="10,0"
                                Margin="0,0,6,0"
                                Background="Transparent"
                                Foreground="#888888"
                                BorderThickness="0"
                                Click="BtnNewSession_Click"/>
                        <Button x:Name="BtnClose"
                                Content="×"
                                FontSize="18"
                                Width="28" Height="28"
                                Background="Transparent"
                                Foreground="#888888"
                                BorderThickness="0"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 消息列表 + 历史抽屉（抽屉列 Auto 跟随 HistoryPanel.Width，宽度动画/拖拽都作用于 HistoryPanel.Width——
                 WPF GridLength 无 DoubleAnimation，铁律：不动画/拖拽 ColumnDefinition）。
                 拖拽用 Thumb（GridSplitter 基类，样式照搬 SettingsWindow 的 splitter）：其自动 resize 只能改列宽，
                 与"只改 HistoryPanel.Width"铁律冲突，故 DragDelta 手动改控件宽度。 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:HistoryDrawer x:Name="HistoryPanel" Grid.Column="0" Width="0"/>
                <Thumb x:Name="DrawerSplitter" Grid.Column="1" Width="5" Margin="0,0"
                       Cursor="SizeWE" DragDelta="DrawerSplitter_DragDelta" DragCompleted="DrawerSplitter_DragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent">
                                <Rectangle Width="1" HorizontalAlignment="Center" Fill="#3A3A3A"/>
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <ScrollViewer x:Name="MessagesScroll" Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              Padding="14,10">
                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <Border Background="#252525"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            MaxWidth="520"
                                            HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#252525"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Background" Value="#2A3A2A"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock x:Name="RoleLabel"
                                                       FontSize="10"
                                                       Foreground="#777777"
                                                       Margin="0,0,0,3"/>
                                            <!-- 思考过程：灰色斜体可折叠，仅思考型模型产生内容时显示 -->
                                            <Expander x:Name="ReasoningArea"
                                                      Header="思考过程"
                                                      FontSize="11"
                                                      Foreground="#888888"
                                                      IsExpanded="{Binding IsReasoningOpen, Mode=TwoWay}"
                                                      Margin="0,0,0,4">
                                                <Expander.Visibility>
                                                    <Binding Path="HasReasoning">
                                                        <Binding.Converter>
                                                            <BooleanToVisibilityConverter/>
                                                        </Binding.Converter>
                                                    </Binding>
                                                </Expander.Visibility>
                                                <TextBox Text="{Binding ReasoningText, Mode=OneWay}"
                                                         TextWrapping="Wrap"
                                                         IsReadOnly="True"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="#9E9E9E"
                                                         FontSize="11"
                                                         FontStyle="Italic"
                                                         Padding="0"
                                                         MaxHeight="180"
                                                         VerticalScrollBarVisibility="Auto"/>
                                            </Expander>
                                            <!-- Agent 工具调用步骤（过程记录，回答完成后保留） -->
                                            <TextBlock x:Name="ToolStepsText"
                                                       Text="{Binding ToolSteps}"
                                                       FontSize="10"
                                                       Foreground="#6E8B6E"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,4"
                                                       Visibility="{Binding HasToolSteps, Converter={StaticResource BoolToVis}}"/>
                                            <!-- 只读 TextBox：支持拖选部分文字回填（TextBlock 不支持选中） -->
                                            <TextBox x:Name="BubbleText"
                                                     Text="{Binding Content}"
                                                     TextWrapping="Wrap"
                                                     IsReadOnly="True"
                                                     IsReadOnlyCaretVisible="False"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="#E0E0E0"
                                                     FontSize="13"
                                                     Padding="0"/>
                                            <!-- 附件区（2026-09-14）：与输入区同一种卡片（图标前缀 + 截断文件名），
                                                 悬停出预览、双击看大图/打开原文件。刻意不复刻输入区里的精确交错顺序——
                                                 气泡正文是纯文本控件，顺序仍在会话数据里（InsertOffset），上行请求照旧还原 -->
                                            <ItemsControl x:Name="BubbleAttachments"
                                                          ItemsSource="{Binding Attachments}"
                                                          Margin="0,6,0,0"
                                                          Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="BubbleChip"
                                                                Background="#1E1E1E"
                                                                BorderBrush="#378ADD"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,1"
                                                                Margin="0,0,6,4"
                                                                Cursor="Hand"
                                                                VerticalAlignment="Center"
                                                                MouseEnter="AttachmentChip_MouseEnter"
                                                                MouseLeave="AttachmentChip_MouseLeave"
                                                                MouseLeftButtonDown="AttachmentChip_MouseDown">
                                                            <TextBlock Text="{Binding ChipText}"
                                                                       FontSize="12"
                                                                       Foreground="#CCCCCC"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                                <Setter TargetName="BubbleChip" Property="BorderBrush" Value="#888780"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                <Setter TargetName="BubbleChip" Property="BorderBrush" Value="#5A5A5A"/>
                                                                <Setter TargetName="BubbleChip" Property="Background" Value="#232323"/>
                                                                <Setter TargetName="BubbleChip" Property="Cursor" Value="Arrow"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFillable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button x:Name="FillAppendButton"
                                                        Content="追加到原笔记"
                                                        FontSize="11"
                                                        Height="24"
                                                        Padding="10,0"
                                                        Margin="0,0,6,0"
                                                        HorizontalAlignment="Left"
                                                        Background="#2D2D2D"
                                                        Foreground="#4CAF50"
                                                        BorderBrush="#4CAF50"
                                                        Tag="{Binding}"
                                                        Click="BtnFillAppend_Click"/>
                                                <Button x:Name="FillNewButton"
                                                        Content="存为新笔记"
                                                        FontSize="11"
                                                        Height="24"
                                                        Padding="10,0"
                                                        HorizontalAlignment="Left"
                                                        Background="#2D2D2D"
                                                        Foreground="#888888"
                                                        BorderBrush="#555555"
                                                        Tag="{Binding}"
                                                        Click="BtnFillNew_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="RoleLabel" Property="Text" Value="我"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUser}" Value="False">
                                        <Setter TargetName="RoleLabel" Property="Text" Value="AI"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFilled}" Value="True">
                                        <Setter TargetName="FillAppendButton" Property="Content" Value="已回填"/>
                                        <Setter TargetName="FillAppendButton" Property="IsEnabled" Value="False"/>
                                        <Setter TargetName="FillNewButton" Property="Content" Value="已回填"/>
                                        <Setter TargetName="FillNewButton" Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 输入区（2026-09-14：支持图片/文档，文字与附件混排）
                 结构：加号按钮 + 富文本输入区 + 发送按钮。
                 AllowDrop 设在本 Border 上（拖文件到输入区即添加；不设窗口级，避免与消息区滚动冲突）。
                 注意：输入框自身也要接受拖放 —— RichTextBox 内置了文本拖放处理，会先把拖拽事件标记为
                 已处理，只有显式接管（见 InitInputArea）才能在框内正上方生效。 -->
            <Border Grid.Row="2" Background="#252525" CornerRadius="0,0,6,6" Padding="12,10"
                    AllowDrop="True" DragOver="InputArea_DragOver" Drop="InputArea_Drop">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 加号：打开文件选择框。Padding=0 必须显式设置——全局 Button 样式是 8,4，会挤偏图标。
                         图标用矢量 Path 而非 "+" 字符：字体里的加号字形在行框内本身不居中，
                         无论怎么调字号/内边距都消不掉那点偏差，矢量图形才能真居中。 -->
                    <Button x:Name="BtnAttach"
                            Grid.Column="0"
                            Width="30" Height="30"
                            Padding="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Bottom"
                            Background="#1E1E1E"
                            Foreground="#AAAAAA"
                            BorderBrush="#555555"
                            ToolTip="添加图片或文档（也可直接 Ctrl+V 粘贴、或把文件拖进来）"
                            Click="BtnAttach_Click">
                        <Path Data="M0,6 H12 M6,0 V12"
                              Stroke="#BBBBBB"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>

                    <!-- 富文本输入区：文字与附件块混排。
                         MaxHeight 放在外框上，内部 ScrollViewer 管滚动 —— 输入区随内容长高，到上限后内部滚动。
                         MinHeight 给足两行，避免刚打开会话时只有窄窄一条。 -->
                    <Border Grid.Column="1"
                            Background="#1E1E1E"
                            BorderBrush="#555555"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            MaxHeight="160">
                        <Grid>
                            <ScrollViewer x:Name="InputScroll" VerticalScrollBarVisibility="Auto">
                                <RichTextBox x:Name="InputBox"
                                             MinHeight="40"
                                             Background="Transparent"
                                             Foreground="#E0E0E0"
                                             CaretBrush="#E0E0E0"
                                             SelectionBrush="#3A5A8A"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontSize="13"
                                             AcceptsReturn="True"
                                             IsDocumentEnabled="True"
                                             AllowDrop="True"
                                             VerticalScrollBarVisibility="Disabled"
                                             PreviewKeyDown="InputBox_PreviewKeyDown"/>
                            </ScrollViewer>
                            <!-- 占位提示：输入区加高后空白区域需要一句引导，否则像个坏掉的框 -->
                            <TextBlock x:Name="InputPlaceholder"
                                       Text="输入问题，Ctrl+V 可粘贴图片，或把文件拖进来"
                                       Foreground="#7A7A7A"
                                       FontSize="13"
                                       VerticalAlignment="Top"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <Button x:Name="BtnSend"
                            Grid.Column="2"
                            Content="发送"
                            Width="72" Height="30"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            Background="#3A3A3A"
                            Foreground="#4CAF50"
                            BorderBrush="#4CAF50"
                            Click="BtnSend_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
