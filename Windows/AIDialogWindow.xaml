<Window x:Class="FocusCapture.Windows.AIDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FocusCapture.Windows.Controls"
        Title="AI 问答"
        Width="640" Height="560"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 2026-09-21：滚动条样式上收到 App.xaml 全局隐式样式（原窗口内的 ScrollbarStyle 只定义未引用，已删） -->
    </Window.Resources>

    <Border CornerRadius="6" Background="#1E1E1E"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（底部 2px 品牌绿 accent 线，配色方案 B 的标志） -->
            <Border Grid.Row="0" Background="#252525" CornerRadius="6,6,0,0"
                    BorderBrush="#4CAF50" BorderThickness="0,0,0,2">
                <Grid Margin="14,0">
                    <TextBlock x:Name="TitleText"
                               Text="AI 问答"
                               Foreground="#CCCCCC"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <!-- 2026-09-24：标题栏「历史」「+ 新会话」按钮已删 —— 开关侧边栏交给主区左上角
                         BtnToggleSidebar，新会话交给侧边栏「新对话」（用户拍板：标题栏只留标题）。
                         关窗走原生标题栏 ×（旧窗口内关闭按钮的字形裁切问题见下）。 -->
                </Grid>
            </Border>

            <!-- 消息列表 + 侧边栏（列 Auto 跟随 Sidebar.Width，宽度动画/拖拽都作用于 Sidebar.Width——
                 WPF GridLength 无 DoubleAnimation，铁律：不动画/拖拽 ColumnDefinition）。
                 拖拽用 Thumb（GridSplitter 基类，样式照搬 SettingsWindow 的 splitter）：其自动 resize 只能改列宽，
                 与"只改 Sidebar.Width"铁律冲突，故 DragDelta 手动改控件宽度。 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 主区左上角：展开/收起侧边栏 + 全局搜索（2026-09-24，取代标题栏「历史」按钮）。
                 两按钮在主区列(Grid.Column="2")顶部，不随侧边栏宽度裁剪；BtnToggleSidebar 文案按抽屉状态切换。 -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="6,6,0,0" Orientation="Horizontal" Panel.ZIndex="50">
                <Button x:Name="BtnToggleSidebar" Click="BtnToggleSidebar_Click"
                        Width="28" Height="28" Padding="0" FontSize="15"
                        Background="#2A2A2A" Foreground="#B8B8B8" BorderBrush="#3A3A3A"
                        ToolTip="展开侧边栏">≡</Button>
                <Button x:Name="BtnGlobalSearch" Click="BtnGlobalSearch_Click"
                        Width="28" Height="28" Padding="0" Margin="4,0,0,0"
                        Background="#2A2A2A" Foreground="#B8B8B8" BorderBrush="#3A3A3A"
                        ToolTip="搜索会话（跨所有会话搜消息正文）">
                    <Path Data="M6,6 m-4.2,0 a4.2,4.2 0 1,0 8.4,0 a4.2,4.2 0 1,0 -8.4,0 M9.4,9.4 L13,13"
                          Stroke="#B8B8B8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </StackPanel>
            <controls:ChatSidebar x:Name="Sidebar" Grid.Column="0" Width="0"/>
                <Thumb x:Name="DrawerSplitter" Grid.Column="1" Width="5" Margin="0,0"
                       Cursor="SizeWE" DragDelta="DrawerSplitter_DragDelta" DragCompleted="DrawerSplitter_DragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent">
                                <Rectangle Width="1" HorizontalAlignment="Center" Fill="#3A3A3A"/>
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>

                <!-- 2026-09-21 重排：对话列（消息区 + 输入区）收进第三列 —— 历史抽屉列纵贯全窗，
                     输入区与对话区同宽，拖抽屉时输入区实时跟随（用户要求"分区管理"）。
                     原结构：消息区在 Row1 的第三列、输入区横贯整窗底部（Row2）。 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 分组视图（2026-09-23）：点侧边栏的分组进来。与消息区同占 Row 0，用 Visibility 互斥 ——
                         不新增行，输入区原地不动（在分组里输入 = 在该分组下新建会话）。 -->
                    <Grid x:Name="GroupViewPanel" Grid.Row="0" Visibility="Collapsed" Background="#1E1E1E">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 工具行两态（2026-09-24 用户要求）：
                             默认态 = 分组名 + 添加指令 + 搜索/编辑名/删除（后两个用图标）；
                             搜索态 = 搜索框覆盖整行（× 退出）。
                             没有「返回对话」按钮 —— 退出分组靠发消息（自动回到正常对话）
                             或点侧边栏的任意项（用户 2026-09-24 拍板）。 -->
                        <Grid Grid.Row="0" Margin="14,12,14,4">
                            <WrapPanel x:Name="GroupToolbar" VerticalAlignment="Center">
                                <TextBlock x:Name="GroupViewTitle" FontSize="15" Foreground="#E8E8E8"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Button x:Name="BtnGroupInstruction" Content="添加指令" Click="BtnGroupInstruction_Click"
                                        Padding="8,3" Margin="0,0,6,0" FontSize="12" Cursor="Hand"
                                        Background="#2A2A2A" Foreground="#C8C8C8" BorderBrush="#3A3A3A" BorderThickness="1"/>
                                <Button x:Name="BtnGroupSearch" Click="BtnGroupSearch_Click"
                                        Width="26" Height="24" Padding="0" Margin="0,0,6,0" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTip="搜索本分组内的会话（含消息正文）">
                                    <Path Data="M6,6 m-4.2,0 a4.2,4.2 0 1,0 8.4,0 a4.2,4.2 0 1,0 -8.4,0 M9.4,9.4 L13,13"
                                          Stroke="#A8A8A8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                                <Button x:Name="BtnGroupRename" Click="BtnGroupRename_Click"
                                        Width="26" Height="24" Padding="0" Margin="0,0,6,0" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTip="编辑分组名">
                                    <Path Data="M1.5,10.5 L1.5,13 L4,13 L12.5,4.5 L10,2 Z M9,3 L11.5,5.5"
                                          Stroke="#A8A8A8" StrokeThickness="1.3" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                                <Button x:Name="BtnGroupDelete" Click="BtnGroupDelete_Click"
                                        Width="26" Height="24" Padding="0" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTip="删除分组（组内会话回到未分组）">
                                    <Path Data="M2,4 H12 M5.5,4 V2.5 H8.5 V4 M3.8,4 L4.5,13.5 H9.5 L10.2,4 M6.3,6.5 V11 M7.7,6.5 V11"
                                          Stroke="#C08080" StrokeThickness="1.3" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                            </WrapPanel>
                            <!-- 搜索态：覆盖工具行（展开/收起由 code-behind 切 Visibility）-->
                            <Grid x:Name="GroupSearchBar" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#3A3A3A"
                                        BorderThickness="1" CornerRadius="6" Padding="8,4">
                                    <Grid>
                                        <TextBox x:Name="GroupSearchBox" Background="Transparent"
                                                 Foreground="#E0E0E0" CaretBrush="#E0E0E0"
                                                 BorderThickness="0" FontSize="12"
                                                 VerticalAlignment="Center"
                                                 TextChanged="GroupSearchBox_TextChanged"/>
                                        <TextBlock x:Name="GroupSearchPlaceholder"
                                                   Text="搜索本分组内的消息内容…"
                                                   Foreground="#6A6A6A" FontSize="12"
                                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                                <Button x:Name="BtnGroupSearchClose" Grid.Column="1" Click="BtnGroupSearchClose_Click"
                                        Width="26" Height="24" Padding="0" Margin="6,0,0,0" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTip="退出搜索">
                                    <Path Data="M3,3 L11,11 M11,3 L3,11"
                                          Stroke="#A8A8A8" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- 该分组当前的指令（只读展示；改要点上面的「添加指令」）-->
                        <TextBlock x:Name="GroupInstructionText" Grid.Row="1" Margin="14,0,14,8"
                                   Foreground="#8A8A8A" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                            <StackPanel>
                                <ItemsControl x:Name="GroupSessionList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" CornerRadius="4" Padding="8,6" Margin="0,1"
                                                    Cursor="Hand" MouseLeftButtonUp="GroupSessionRow_Click" Tag="{Binding}"
                                                    ToolTip="{Binding Preview}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#C8C8C8"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="#6E6E6E"
                                                               FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="GroupSessionEmptyHint"
                                           Text="这个分组还没有会话 —— 在下面输入框里说第一句，就会开始一个属于它的话题。"
                                           Foreground="#7A7A7A" FontSize="12" Margin="8,6,8,0"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 起手页（2026-09-23）：空会话时显示自定义欢迎语（**只有文字**），
                         此刻输入区被摆到正中间（见 ApplyComposerLayout），发第一条消息后一起沉底。
                         2026-09-26：欢迎语图标（Image）按用户要求删除 —— 设置里对应入口同步删除。 -->
                    <Grid x:Name="WelcomePanel" Grid.Row="0" Visibility="Collapsed">
                        <!-- 底部 180 的留白是刻意的：输入区居中时中心也在 Row 0 的中心，
                             欢迎语靠这个偏移让出它头顶的位置，两者不会叠在一起。 -->
                        <TextBlock x:Name="WelcomeText" FontSize="18" Foreground="#D8D8D8"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Margin="32,0,32,180"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
                    </Grid>

                    <ScrollViewer x:Name="MessagesScroll" Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="14,10">
                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <Border Background="#252525"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            MaxWidth="520"
                                            HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#252525"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Background" Value="#2A3A2A"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SearchHighlight}" Value="True">
                                                        <Setter Property="Background" Value="#3A4A2A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock x:Name="RoleLabel"
                                                       FontSize="10"
                                                       Foreground="#777777"
                                                       Margin="0,0,0,3"/>
                                            <!-- 思考过程：灰色斜体可折叠，仅思考型模型产生内容时显示 -->
                                            <Expander x:Name="ReasoningArea"
                                                      Header="思考过程"
                                                      FontSize="11"
                                                      Foreground="#888888"
                                                      IsExpanded="{Binding IsReasoningOpen, Mode=TwoWay}"
                                                      Margin="0,0,0,4">
                                                <Expander.Visibility>
                                                    <Binding Path="HasReasoning">
                                                        <Binding.Converter>
                                                            <BooleanToVisibilityConverter/>
                                                        </Binding.Converter>
                                                    </Binding>
                                                </Expander.Visibility>
                                                <TextBox Text="{Binding ReasoningText, Mode=OneWay}"
                                                         TextWrapping="Wrap"
                                                         IsReadOnly="True"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="#9E9E9E"
                                                         FontSize="11"
                                                         FontStyle="Italic"
                                                         Padding="0"
                                                         MaxHeight="180"
                                                         VerticalScrollBarVisibility="Auto"/>
                                            </Expander>
                                            <!-- Agent 工具调用步骤（过程记录，回答完成后保留） -->
                                            <TextBlock x:Name="ToolStepsText"
                                                       Text="{Binding ToolSteps}"
                                                       FontSize="10"
                                                       Foreground="#6E8B6E"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,4"
                                                       Visibility="{Binding HasToolSteps, Converter={StaticResource BoolToVis}}"/>
                                            <!-- 只读 TextBox：支持拖选部分文字回填（TextBlock 不支持选中） -->
                                            <TextBox x:Name="BubbleText"
                                                     Text="{Binding Content}"
                                                     TextWrapping="Wrap"
                                                     IsReadOnly="True"
                                                     IsReadOnlyCaretVisible="False"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="#E0E0E0"
                                                     FontSize="13"
                                                     Padding="0"/>
                                            <!-- 附件区（2026-09-14）：与输入区同一种卡片（图标前缀 + 截断文件名），
                                                 悬停出预览、双击看大图/打开原文件。刻意不复刻输入区里的精确交错顺序——
                                                 气泡正文是纯文本控件，顺序仍在会话数据里（InsertOffset），上行请求照旧还原 -->
                                            <ItemsControl x:Name="BubbleAttachments"
                                                          ItemsSource="{Binding Attachments}"
                                                          Margin="0,6,0,0"
                                                          Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="BubbleChip"
                                                                Background="#1E1E1E"
                                                                BorderBrush="#378ADD"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,1"
                                                                Margin="0,0,6,4"
                                                                Cursor="Hand"
                                                                VerticalAlignment="Center"
                                                                MouseEnter="AttachmentChip_MouseEnter"
                                                                MouseLeave="AttachmentChip_MouseLeave"
                                                                MouseLeftButtonDown="AttachmentChip_MouseDown">
                                                            <TextBlock Text="{Binding ChipText}"
                                                                       FontSize="12"
                                                                       Foreground="#CCCCCC"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                                <Setter TargetName="BubbleChip" Property="BorderBrush" Value="#888780"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                <Setter TargetName="BubbleChip" Property="BorderBrush" Value="#5A5A5A"/>
                                                                <Setter TargetName="BubbleChip" Property="Background" Value="#232323"/>
                                                                <Setter TargetName="BubbleChip" Property="Cursor" Value="Arrow"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- 云文件卡片（2026-09-16）：从网盘取回的文件落进对话，
                                                 卡片上给三个动作。取回后文件已在本机，所以「打开 / 定位」几乎零成本。 -->
                                            <ItemsControl x:Name="BubbleCloudFiles"
                                                          ItemsSource="{Binding CloudFiles}"
                                                          Margin="0,6,0,0"
                                                          Visibility="{Binding HasCloudFiles, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1E1E1E"
                                                                BorderBrush="#C9A227"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="8,3"
                                                                Margin="0,0,6,4"
                                                                VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}"
                                                                           FontSize="12"
                                                                           Foreground="#DDDDDD"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0"/>
                                                                <Button Content="打开"
                                                                        FontSize="11" Height="22" Padding="8,0" Margin="0,0,4,0"
                                                                        Background="#2D2D2D" Foreground="#4CAF50" BorderBrush="#4CAF50"
                                                                        Tag="{Binding}" Click="CloudFile_Open_Click"/>
                                                                <Button Content="定位"
                                                                        FontSize="11" Height="22" Padding="8,0" Margin="0,0,4,0"
                                                                        Background="#2D2D2D" Foreground="#AAAAAA" BorderBrush="#555555"
                                                                        Tag="{Binding}" Click="CloudFile_Locate_Click"/>
                                                                <Button Content="另存"
                                                                        FontSize="11" Height="22" Padding="8,0" Margin="0,0,4,0"
                                                                        Background="#2D2D2D" Foreground="#AAAAAA" BorderBrush="#555555"
                                                                        Tag="{Binding}" Click="CloudFile_SaveAs_Click"/>
                                                                <Button Content="彻底删除"
                                                                        FontSize="11" Height="22" Padding="8,0"
                                                                        Background="#2D2D2D" Foreground="#E08585" BorderBrush="#8A3A3A"
                                                                        ToolTip="从本机与网盘一起删除（网盘侧可在回收站找回）"
                                                                        Tag="{Binding}" Click="CloudFile_Delete_Click"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFillable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button x:Name="FillAppendButton"
                                                        Content="追加到原笔记"
                                                        FontSize="11"
                                                        Height="24"
                                                        Padding="10,0"
                                                        Margin="0,0,6,0"
                                                        HorizontalAlignment="Left"
                                                        Background="#2D2D2D"
                                                        Foreground="#4CAF50"
                                                        BorderBrush="#4CAF50"
                                                        Tag="{Binding}"
                                                        Click="BtnFillAppend_Click"/>
                                                <Button x:Name="FillNewButton"
                                                        Content="存为新笔记"
                                                        FontSize="11"
                                                        Height="24"
                                                        Padding="10,0"
                                                        HorizontalAlignment="Left"
                                                        Background="#2D2D2D"
                                                        Foreground="#888888"
                                                        BorderBrush="#555555"
                                                        Tag="{Binding}"
                                                        Click="BtnFillNew_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="RoleLabel" Property="Text" Value="我"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUser}" Value="False">
                                        <Setter TargetName="RoleLabel" Property="Text" Value="AI"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFilled}" Value="True">
                                        <Setter TargetName="FillAppendButton" Property="Content" Value="已回填"/>
                                        <Setter TargetName="FillAppendButton" Property="IsEnabled" Value="False"/>
                                        <Setter TargetName="FillNewButton" Property="Content" Value="已回填"/>
                                        <Setter TargetName="FillNewButton" Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 输入区（2026-09-14：支持图片/文档，文字与附件块混排）
                     结构：加号按钮 + 富文本输入区 + 发送按钮。
                     AllowDrop 设在本 Border 上（拖文件到输入区即添加；不设窗口级，避免与消息区滚动冲突）。
                     注意：输入框自身也要接受拖放 —— RichTextBox 内置了文本拖放处理，会先把拖拽事件标记为
                     已处理，只有显式接管（见 InitInputArea）才能在框内正上方生效。
                     2026-09-21 重排：从窗口底行挪进对话列（Row1），宽度跟随历史抽屉联动。
                     左下圆角由代码按抽屉开合切换（InputAreaCornerRadius）。 -->
                <Border x:Name="InputArea" Grid.Row="1" Background="#252525" CornerRadius="0,0,6,6" Padding="12,10"
                        AllowDrop="True" DragOver="InputArea_DragOver" Drop="InputArea_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 已选择的本地文件（2026-09-16，红线）：
                         用户点「选择文件」后这里出现一张牌号卡片，AI 只能引用卡片上的牌号（file:yyyyMMdd-N）。
                         路径永远不进模型 —— 模型编不出牌号，也就碰不到没被点过的文件。
                         刻意与下方附件卡片区分配色（金黄描边）：附件是要发给模型的内容，这里是「AI 可操作的本机文件」。 -->
                    <ItemsControl x:Name="HandleChips" Grid.Row="0" Margin="0,0,0,6"
                                  Visibility="{Binding HasHandles, ElementName=Self_HandleHost, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 2026-09-21：MaxWidth 卡住卡片上限 —— 长文件名此前会把"×"挤出窗口
                                     （WrapPanel 无法从中间折断一张卡片）。文件名用省略号截断，全名悬停可见。 -->
                                <Border Background="#2A2A1E"
                                        BorderBrush="#C9A227"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        MaxWidth="320"
                                        Margin="0,0,6,4"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        ToolTip="{Binding Path}"
                                        MouseLeftButtonDown="HandleChip_MouseDown">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="本机文件"
                                                   FontSize="10"
                                                   Foreground="#C9A227"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="12"
                                                   Foreground="#DDDDDD"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Id}"
                                                   FontSize="10"
                                                   Foreground="#8A8A8A"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                        <TextBlock Text="×"
                                                   FontSize="13"
                                                   Foreground="#999999"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Cursor="Hand"
                                                   ToolTip="取消选择该文件"
                                                   Tag="{Binding Id}"
                                                   MouseLeftButtonUp="HandleChipRemove_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                <!-- 输入区（2026-09-24 按 WorkBuddy 重排）：加号与发送按钮收进输入框内部
                     （原先分居两侧各占约 40px，把输入框夹窄 —— 用户反馈"输入框太窄"）；
                     发送按钮改圆形 + 向上箭头（用户："怎么是向右的箭头，做成和 Workbuddy 一样的"）；
                     框下加「选择分组」入口（对标 WorkBuddy 的"选择工作空间"：开对话前先选好分组）。
                     HandleChips（本机文件牌号卡）留在外层 Grid 的 Row0 —— 它只在这里定义一次，
                     重复定义 x:Name 会直接编译错（CS0102 实测）。 -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 输入框容器：文字区在上、按钮行在下（WorkBuddy 式）。AllowDrop 拖文件即附件 -->
                    <Border Grid.Row="0"
                            Background="#1E1E1E"
                            BorderBrush="#555555"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,8"
                            MaxHeight="180"
                            AllowDrop="True" DragOver="InputArea_DragOver" Drop="InputArea_Drop">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 富文本输入区：文字与附件块混排。MinHeight 压到 22（2026-09-21 拍板）；
                                 内部 ScrollViewer 管滚动 —— 随内容长高，到 MaxHeight 后内部滚动 -->
                            <Grid Grid.Row="0">
                                <ScrollViewer x:Name="InputScroll" VerticalScrollBarVisibility="Auto">
                                    <RichTextBox x:Name="InputBox"
                                                 MinHeight="22"
                                                 Background="Transparent"
                                                 Foreground="#E0E0E0"
                                                 CaretBrush="#E0E0E0"
                                                 SelectionBrush="#3A5A8A"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 FontSize="13"
                                                 AcceptsReturn="True"
                                                 IsDocumentEnabled="True"
                                                 AllowDrop="True"
                                                 VerticalScrollBarVisibility="Disabled"
                                                 PreviewKeyDown="InputBox_PreviewKeyDown"/>
                                </ScrollViewer>
                                <!-- 占位提示：输入区加高后空白区域需要一句引导，否则像个坏掉的框 -->
                                <TextBlock x:Name="InputPlaceholder"
                                           Text="输入问题，Ctrl+V 可粘贴图片，或把文件拖进来"
                                           Foreground="#7A7A7A"
                                           FontSize="13"
                                           VerticalAlignment="Top"
                                           IsHitTestVisible="False"/>
                            </Grid>

                            <!-- 按钮行：加号（附件+引用文件菜单）在左，发送在右 -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <!-- 加号：点开弹两项（语义严格区分，不合并实现）：
                                     添加附件 = 文件发给模型看（占上下文）；引用文件 = 只给牌号，路径不进模型 -->
                                <Button x:Name="BtnAttach"
                                        Width="28" Height="28"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTip="添加附件或引用文件。也可直接 Ctrl+V 粘贴、或把文件拖进来"
                                        Click="BtnAttach_Click">
                                    <Path Data="M0,6 H12 M6,0 V12"
                                          Stroke="#BBBBBB"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Button>

                                <!-- 会话级模型切换（2026-09-24 任务5）：点开弹所有可用模型，选中只改本会话 ModelKey。
                                     空 = 跟随全局默认；新建会话已写入当时全局默认，这里可改。 -->
                                <Button x:Name="BtnSessionModel" Click="BtnSessionModel_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,38,2"
                                        Padding="6,2" FontSize="11" Cursor="Hand"
                                        Background="Transparent" Foreground="#9A9A9A" BorderThickness="0"
                                        ToolTip="切换本会话使用的模型（只影响本会话）">模型 ▾</Button>

                                <!-- 发送（2026-09-24）：圆形 + 向上箭头（WorkBuddy 式）。
                                     局部模板只是"去外壳"（全局样式的方形底/悬停变色对圆形按钮是灾难），
                                     圆形底和图标都放内容里 —— code-behind 按 x:Name 直接换图标，
                                     元素必须在 NameScope 里（放模板里就得改用 Template.FindName）。 -->
                                <Button x:Name="BtnSend"
                                        Width="30" Height="30"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="发送（Enter）"
                                        Click="BtnSend_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <!-- 图标坐标系刻意写成按钮内容区 30×30 本身、几何以 (15,15) 为中心手算：
                                         2026-09-26 修「箭头明显不居中」—— 原 Data 用的是 0..13 的坐标 + 默认 Stretch=None，
                                         控件被 Grid 居中、几何却按自身原点画，整体偏右下。 -->
                                    <Grid>
                                        <Border x:Name="SendCircle" Background="#4CAF50" CornerRadius="15"/>
                                        <Path x:Name="SendIcon"
                                              Width="30" Height="30" Stretch="None"
                                              Data="M15,21.5 L15,8.5 M10.5,13 L15,8.5 L19.5,13"
                                              Stroke="#FFFFFF" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <!-- 回答中：蓝底圆 + 中心白色圆角方块（用户给的"铜钱"样式，2026-09-26）。
                                             圆底色由 code-behind 的 SetBusyUi 切换，这里只放两个图标。 -->
                                        <Border x:Name="StopIcon" Width="11" Height="11" CornerRadius="3"
                                                Background="#FFFFFF" Visibility="Collapsed"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 选择分组（2026-09-24 补做，对标 WorkBuddy 的「选择工作空间」）：
                         起手态点它选目标分组，发第一句时会话直接建在该分组；
                         对话态显示当前会话所属分组，点击可移动归属 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,6,0,0">
                        <Button x:Name="BtnPickGroup" Click="BtnPickGroup_Click"
                                Padding="6,2" FontSize="12" Cursor="Hand"
                                Background="Transparent" Foreground="#8A9E8A" BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M1,1 H13 V13 H1 Z M1,5 H13"
                                      Stroke="#8A9E8A" StrokeThickness="1.2" Margin="0,0,5,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock x:Name="PickGroupLabel" Text="选择分组" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                </Grid>
            </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
