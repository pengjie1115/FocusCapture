<Window x:Class="FocusCapture.Windows.SkillAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skill 依赖授权"
        Width="470" Height="668"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#777777"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeadText"
                   Text="用飞书扫码授权"
                   FontSize="15" Foreground="#F0F0F0" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1" x:Name="DepText" Margin="0,8,0,0"
                   Foreground="#AAAAAA" TextWrapping="Wrap"
                   Text="依赖：飞书（lark-cli）"/>

        <Border Grid.Row="2" Margin="0,14,0,0" Width="320" Height="320"
                HorizontalAlignment="Center"
                Background="#FFFFFF" CornerRadius="6" Padding="10">
            <Grid>
                <TextBlock x:Name="QrPlaceholder" Text="正在生成二维码…"
                           Foreground="#666666" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <Image x:Name="QrImage" Stretch="Uniform" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,12,0,4"
                   Foreground="#888888" FontSize="11"
                   Text="用飞书 App 扫上面的码 → 在手机上点「确认授权」。扫码后本窗口会自动完成，不用再点任何按钮。"/>

        <TextBox Grid.Row="4" x:Name="UrlBox" IsReadOnly="True" TextWrapping="Wrap"
                 MaxHeight="46" VerticalScrollBarVisibility="Auto"
                 ToolTip="二维码扫不了时，可以复制这个链接在浏览器里打开"/>

        <TextBlock Grid.Row="5" x:Name="StatusText" Margin="0,12,0,0"
                   Foreground="#CFCFCF" TextWrapping="Wrap"
                   Text="正在获取授权码…"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenLinkButton" Content="在浏览器打开" Margin="0,0,8,0" Click="OnOpenLink"/>
            <Button x:Name="RetryButton" Content="重新生成二维码" Margin="0,0,8,0" Click="OnRetry" Visibility="Collapsed"/>
            <Button x:Name="CancelButton" Content="取消" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
