<Window x:Class="FocusCapture.Windows.ChatSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="搜索会话" Width="500" Height="560"
        MinWidth="360" MinHeight="400"
        ShowInTaskbar="False"
        Background="#1E1E1E" Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <!-- 全局搜索弹窗（2026-09-24）：跨所有会话搜消息正文，点结果跳转会话。
         搜索底层 = ChatSearchService.Search(query, null)（null = 搜全部会话含已分组），
         防抖 280ms、后台线程（服务是同步阻塞 + 磁盘 IO，见 ChatSearchService 头注释）。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#252525" Padding="10,8">
            <Grid>
                <TextBox x:Name="SearchBox" Background="#1A1A1A" Foreground="#E0E0E0"
                         CaretBrush="#E0E0E0" BorderBrush="#3A3A3A" BorderThickness="1"
                         Padding="8,5" VerticalContentAlignment="Center"
                         KeyDown="SearchBox_KeyDown"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="Placeholder" Text="输入关键词搜消息正文…"
                           Foreground="#6A6A6A" Padding="10,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                <ItemsControl x:Name="ResultList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2A2A2A" CornerRadius="4" Padding="10,8" Margin="0,0,0,6"
                                    Cursor="Hand" MouseLeftButtonUp="ResultRow_Click" Tag="{Binding}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#D8D8D8" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="#7A7A7A" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Snippet}" Foreground="#A8A8A8" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyHint" Text="输入关键词开始搜索（搜消息正文，跨所有会话）"
                       Foreground="#7A7A7A" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="20"/>
            <TextBlock x:Name="SearchingHint" Text="搜索中…" Visibility="Collapsed"
                       Foreground="#7A7A7A" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
        </Grid>
    </Grid>
</Window>
