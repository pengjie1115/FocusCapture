<Window x:Class="FocusCapture.Windows.AiTidyPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 整理预览" Width="860" Height="600"
        MinWidth="660" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- 提取待办规则下的一行：待办文字 + 截止日期 + 截止时间 + 删行。
             日期/时间都可留空 = 不带截止时间的待办；文字同样可改（AI 识别错了用户顺手改）。 -->
        <DataTemplate x:Key="TodoRowTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Background="#252525" Foreground="#E0E0E0"
                         BorderBrush="#4CAF50" BorderThickness="1"
                         Padding="6,3" FontSize="13"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding Date}" Width="126" Margin="6,0,0,0"
                            VerticalContentAlignment="Center"
                            ToolTip="截止日期（可留空）"/>
                <TextBox Grid.Column="2" Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" Width="58" Margin="6,0,0,0"
                         VerticalContentAlignment="Center"
                         Background="#252525" Foreground="#E0E0E0"
                         BorderBrush="#3A3A3A" BorderThickness="1"
                         Padding="6,3" FontSize="13"
                         ToolTip="截止时间 HH:mm（可留空；填了时间必须也填日期）"/>
                <Button Grid.Column="3" Content="×" Width="26" Height="24" Margin="6,0,0,0"
                        Background="#3A3A3A" Foreground="#CCCCCC" BorderBrush="#555555"
                        Cursor="Hand" Click="BtnRemoveTodoRow_Click"
                        ToolTip="不创建这一条（只是从本次列表里去掉，不影响原文）"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部说明：状态 + 本次使用的模型（用户能核对"我选的整理模型真的生效了吗"） -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" x:Name="ModelText" Text=""
                       Foreground="#666666" FontSize="11" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="HintText"
                       Text="左边是原文，右边是整理结果（可直接改）。底部可换整理规则重跑，看清了再选右下的出口。"
                       Foreground="#888888" FontSize="12" VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </DockPanel>

        <!-- 两列表头 -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="原文" Foreground="#B8B8B8" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" x:Name="ResultHeader" Text="整理结果" Foreground="#4CAF50"
                       FontSize="12" FontWeight="SemiBold"/>
        </Grid>

        <!-- 对照区：左只读原文 / 右结果（文本流 或 待办行列表，按规则切换），中缝可拖 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="OriginalBox"
                     IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     Background="#252525" Foreground="#AAAAAA"
                     BorderBrush="#3A3A3A" BorderThickness="1"
                     Padding="8,6" FontSize="13"/>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- 文本流形态：整理结果可编辑 -->
            <TextBox Grid.Column="2" x:Name="ResultBox"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     Background="#252525" Foreground="#E0E0E0"
                     BorderBrush="#4CAF50" BorderThickness="1"
                     Padding="8,6" FontSize="13"/>

            <!-- 提取待办形态：逐行待办（文字 + 截止日期 + 截止时间），可直接改 -->
            <ScrollViewer Grid.Column="2" x:Name="TodoHost" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TodoList" ItemTemplate="{StaticResource TodoRowTemplate}"/>
            </ScrollViewer>
        </Grid>

        <!-- 状态行（错误 / 进行中提示）。规则条占了底栏左侧，状态独占一行才放得下长文案 -->
        <TextBlock Grid.Row="3" x:Name="StatusText" Text=""
                   Foreground="#E57373" FontSize="11" Margin="0,6,0,0"
                   TextWrapping="Wrap"/>

        <!-- 底栏：左边规则条（横向滚动，超宽拖动），右边出口 + 关闭。
             顺序按"改动从小到大"排：复制 → 另存 → 创建待办（仅提取待办规则）→ 替换原文 -->
        <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False">
            <!-- 规则条：不设槽位上限，超出宽度横向滚动（2026-09-27 用户拍板，参照表格横向滚动条样式） -->
            <ScrollViewer DockPanel.Dock="Left" MaxWidth="400" VerticalAlignment="Center"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="RuleBar" Orientation="Horizontal"/>
                    <Rectangle Width="1" Height="18" Fill="#3A3A3A" Margin="8,0"/>
                    <Button x:Name="BtnCustom" Content="自定义" FontSize="12" Height="26" Padding="10,0"
                            Background="#3A3A3A" Foreground="#CCCCCC"
                            BorderBrush="#555555" BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="新增 / 修改自定义整理规则（打开设置 → 整理规则；本预览窗保持打开）"
                            Click="BtnCustom_Click"/>
                </StackPanel>
            </ScrollViewer>
            <Button DockPanel.Dock="Right" x:Name="BtnReplace" Content="替换原文" FontSize="12" Height="28" Padding="14,0"
                    Margin="8,0,0,0"
                    Background="#3A3A3A" Foreground="#4CAF50"
                    BorderBrush="#4CAF50" BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="用整理结果原地替换这条内容（原文本会先进回收站，可恢复）"
                    Click="BtnReplace_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnCreateTodos" Content="创建待办" FontSize="12" Height="28" Padding="14,0"
                    Margin="8,0,0,0" Visibility="Collapsed"
                    Background="#3A3A3A" Foreground="#4CAF50"
                    BorderBrush="#4CAF50" BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="把提取出的待办逐条建成真正的待办（带上面选的截止时间），原文不动"
                    Click="BtnCreateTodos_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnSaveAsNew" Content="另存为新笔记" FontSize="12" Height="28" Padding="14,0"
                    Margin="8,0,0,0"
                    Background="#3A3A3A" Foreground="#E0E0E0"
                    BorderBrush="#555555" BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="原文不动，整理结果另存成一条新笔记"
                    Click="BtnSaveAsNew_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnCopy" Content="复制" FontSize="12" Height="28" Padding="14,0"
                    Margin="8,0,0,0"
                    Background="#3A3A3A" Foreground="#E0E0E0"
                    BorderBrush="#555555" BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="只把整理结果复制到剪贴板，什么都不改"
                    Click="BtnCopy_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnClose" Content="关闭" FontSize="12" Height="28" Padding="14,0"
                    Background="#3A3A3A" Foreground="#CCCCCC"
                    BorderBrush="#555555" BorderThickness="1"
                    Cursor="Hand"
                    Click="BtnClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
