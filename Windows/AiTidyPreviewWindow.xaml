<Window x:Class="FocusCapture.Windows.AiTidyPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 整理预览" Width="860" Height="560"
        MinWidth="660" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部说明：状态 + 本次使用的模型（用户能核对"我选的整理模型真的生效了吗"） -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" x:Name="ModelText" Text=""
                       Foreground="#666666" FontSize="11" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="HintText"
                       Text="左边是原文，右边是整理结果（可直接改）。看清了再选下面的三个出口。"
                       Foreground="#888888" FontSize="12" VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </DockPanel>

        <!-- 两列表头 -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="原文" Foreground="#B8B8B8" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" x:Name="ResultHeader" Text="整理结果" Foreground="#4CAF50"
                       FontSize="12" FontWeight="SemiBold"/>
        </Grid>

        <!-- 对照区：左只读原文 / 右可编辑结果，中缝可拖 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="OriginalBox"
                     IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     Background="#252525" Foreground="#AAAAAA"
                     BorderBrush="#3A3A3A" BorderThickness="1"
                     Padding="8,6" FontSize="13"/>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <TextBox Grid.Column="2" x:Name="ResultBox"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     Background="#252525" Foreground="#E0E0E0"
                     BorderBrush="#4CAF50" BorderThickness="1"
                     Padding="8,6" FontSize="13"/>
        </Grid>

        <!-- 出口：三个动作 + 关闭。顺序按"改动从小到大"排：复制 → 另存 → 替换原文 -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Text=""
                       Foreground="#E57373" FontSize="11" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="420"/>
            <Button DockPanel.Dock="Right" x:Name="BtnReplace" Content="替换原文" FontSize="12" Height="28" Padding="14,0"
                    Margin="8,0,0,0"
                    Background="#3A3A3A" Foreground="#4CAF50"
                    BorderBrush="#4CAF50" BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="用整理结果原地替换这条内容（原文本会先进回收站，可恢复）"
                    Click="BtnReplace_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnSaveAsNew" Content="另存为新笔记" FontSize="12" Height="28" Padding="14,0"
                    Margin="8,0,0,0"
                    Background="#3A3A3A" Foreground="#E0E0E0"
                    BorderBrush="#555555" BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="原文不动，整理结果另存成一条新笔记"
                    Click="BtnSaveAsNew_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnCopy" Content="复制" FontSize="12" Height="28" Padding="14,0"
                    Margin="8,0,0,0"
                    Background="#3A3A3A" Foreground="#E0E0E0"
                    BorderBrush="#555555" BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="只把整理结果复制到剪贴板，什么都不改"
                    Click="BtnCopy_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnClose" Content="关闭" FontSize="12" Height="28" Padding="14,0"
                    Background="#3A3A3A" Foreground="#CCCCCC"
                    BorderBrush="#555555" BorderThickness="1"
                    Cursor="Hand"
                    Click="BtnClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
