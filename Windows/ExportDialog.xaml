<Window x:Class="FocusCapture.Windows.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="360" Height="340"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner">

    <Border CornerRadius="8" Background="#1E1E1E"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#252525" CornerRadius="8,8,0,0">
                <Grid Margin="14,0">
                    <TextBlock Text="导出设置"
                               Foreground="#CCCCCC" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Content="×" FontSize="16"
                            Width="24" Height="24"
                            Background="Transparent"
                            Foreground="#888888"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="16,12">

                <!-- Fields -->
                <TextBlock Text="选择导出内容" Foreground="#999999" FontSize="12" Margin="0,0,0,8"/>
                <WrapPanel Margin="0,0,0,14">
                    <CheckBox x:Name="ChkTime" Content="时间"
                              Foreground="#CCCCCC" Margin="0,0,16,6"/>
                    <CheckBox x:Name="ChkSource" Content="来源"
                              Foreground="#CCCCCC" Margin="0,0,16,6"/>
                    <CheckBox x:Name="ChkContent" Content="笔记内容"
                              Foreground="#CCCCCC" Margin="0,0,0,6"/>
                </WrapPanel>

                <!-- Format -->
                <TextBlock Text="导出格式" Foreground="#999999" FontSize="12" Margin="0,0,0,8"/>
                <StackPanel Margin="0,0,0,14">
                    <RadioButton x:Name="RbMarkdown" Content="Markdown"
                                 Foreground="#CCCCCC" GroupName="Format"
                                 IsChecked="True" Margin="0,0,0,4"/>
                    <RadioButton x:Name="RbWord" Content="Word (.docx)"
                                 Foreground="#CCCCCC" GroupName="Format"
                                 Margin="0,0,0,4"/>
                    <RadioButton x:Name="RbTxt" Content="纯文本"
                                 Foreground="#CCCCCC" GroupName="Format"
                                 Margin="0,0,0,4"/>
                </StackPanel>

                <!-- Default folder -->
                <TextBlock Text="默认保存位置" Foreground="#999999" FontSize="12" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtFolderPath"
                               Text="(未设置)"
                               Foreground="#777777" FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Content="更改文件夹"
                            FontSize="11" Width="80" Height="26"
                            Margin="8,0,0,0"
                            Background="#3A3A3A" Foreground="#CCCCCC"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnChangeFolder_Click"/>
                </Grid>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Content="取消" Width="70" Height="30"
                            Background="#3A3A3A" Foreground="#AAAAAA"
                            BorderThickness="0" Cursor="Hand"
                            Margin="0,0,10,0" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnExport" Content="导出" Width="70" Height="30"
                            Background="#0078D4" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnExport_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
