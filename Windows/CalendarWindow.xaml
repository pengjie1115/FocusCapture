<Window x:Class="FocusCapture.Windows.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="340" Height="410"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="8" Background="#1E1E1E"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 月份导航：左/右翻月 + 标题 + 今天 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Button x:Name="BtnPrev"
                        Content="‹" FontSize="18"
                        Width="30" Height="26"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        Foreground="#CCCCCC"
                        BorderBrush="#555555" BorderThickness="1"
                        Cursor="Hand"
                        Click="BtnPrev_Click"/>
                <TextBlock x:Name="MonthTitle"
                           Text=""
                           Foreground="#E0E0E0"
                           FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnNext"
                        Content="›" FontSize="18"
                        Width="30" Height="26"
                        HorizontalAlignment="Right"
                        Margin="0,0,60,0"
                        Background="Transparent"
                        Foreground="#CCCCCC"
                        BorderBrush="#555555" BorderThickness="1"
                        Cursor="Hand"
                        Click="BtnNext_Click"/>
                <Button x:Name="BtnToday"
                        Content="今天" FontSize="11"
                        Height="26" Padding="10,0"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        Foreground="#4CAF50"
                        BorderBrush="#4CAF50" BorderThickness="1"
                        Cursor="Hand"
                        Click="BtnToday_Click"/>
            </Grid>

            <!-- 2026-08-15 修复：弃用 WPF DatePicker（内部 DatePickerTextBox 是 internal 类 + ThemeStyle 锁，
                 无法用 Application.Resources 或 Window.Resources Style 让它变深色）。
                 改用 [TextBox(深色，全局 Style 兜底) + 📅Button 弹 CalendarWindow 复用] 的组合。
                 TextBox 接受 yyyy-MM-dd 输入，📅按钮点击复用当前 CalendarWindow（其实例）作为弹窗让用户点选日期。 -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="从"
                           Foreground="#888888" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="StartInput" Grid.Column="1" Height="28" FontSize="11"
                         VerticalContentAlignment="Center"
                         LostFocus="StartInput_LostFocus"
                         KeyDown="InputBox_KeyDown"/>
                <Button Grid.Column="2" x:Name="BtnStartPick" Content="📅"
                        FontSize="11" Width="28" Height="28" Margin="4,0,0,0"
                        Cursor="Hand" ToolTip="选开始日期"
                        Click="BtnStartPick_Click"/>
                <TextBlock Grid.Column="3" Text="至"
                           Foreground="#888888" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0"/>
                <TextBox x:Name="EndInput" Grid.Column="4" Height="28" FontSize="11"
                         VerticalContentAlignment="Center"
                         LostFocus="EndInput_LostFocus"
                         KeyDown="InputBox_KeyDown"/>
                <Button Grid.Column="5" x:Name="BtnEndPick" Content="📅"
                        FontSize="11" Width="28" Height="28" Margin="4,0,0,0"
                        Cursor="Hand" ToolTip="选截止日期"
                        Click="BtnEndPick_Click"/>
                <Button Grid.Column="6" Content="↩" FontSize="14"
                        Width="28" Height="28" Margin="6,0,0,0"
                        Background="Transparent"
                        Foreground="#888888"
                        BorderBrush="#555555" BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="清除区间，回单日模式"
                        Click="BtnClearRange_Click"/>
            </Grid>

            <!-- 星期表头：日一二三四五六 -->
            <UniformGrid Grid.Row="2" Columns="7" Margin="0,0,0,4">
                <TextBlock Text="日" Foreground="#888888" FontSize="11" HorizontalAlignment="Center"/>
                <TextBlock Text="一" Foreground="#888888" FontSize="11" HorizontalAlignment="Center"/>
                <TextBlock Text="二" Foreground="#888888" FontSize="11" HorizontalAlignment="Center"/>
                <TextBlock Text="三" Foreground="#888888" FontSize="11" HorizontalAlignment="Center"/>
                <TextBlock Text="四" Foreground="#888888" FontSize="11" HorizontalAlignment="Center"/>
                <TextBlock Text="五" Foreground="#888888" FontSize="11" HorizontalAlignment="Center"/>
                <TextBlock Text="六" Foreground="#888888" FontSize="11" HorizontalAlignment="Center"/>
            </UniformGrid>

            <!-- 日期格：热力色背景 -->
            <UniformGrid x:Name="DayGrid" Grid.Row="3" Columns="7"/>

            <!-- 底部提示 -->
            <TextBlock Grid.Row="4"
                       Text="调整区间直接筛选 · 点击日期查看当天笔记 · 颜色越深笔记越多"
                       Foreground="#666666" FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
        </Grid>
    </Border>
</Window>
