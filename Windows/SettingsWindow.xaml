<Window x:Class="FocusCapture.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="450" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- v3.5：深色 ComboBox（下拉项高亮绿色） -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <ContentPresenter Margin="6,3" VerticalAlignment="Center"/>
                                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#E0E0E0"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="content"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,4,22,4"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#2D2D2D" BorderBrush="#555555" BorderThickness="1"
                                        CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="Background" Value="#3A3A3A" TargetName="toggle"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" Focusable="False">

            <!-- 热键设置 -->
            <TextBlock Text="热键设置" FontSize="16" FontWeight="Bold"
                       Foreground="#4CAF50" Margin="0,0,0,12"/>

            <!-- 呼出输入框 -->
            <DockPanel Margin="0,4">
                <TextBlock Text="呼出输入框" Width="130" VerticalAlignment="Center"/>
                <Button x:Name="BtnSummonHotkey" Width="200" HorizontalAlignment="Right"
                        Click="BtnSummon_Click"/>
            </DockPanel>

            <!-- 剪贴板自动捕获开关 -->
            <DockPanel Margin="0,8">
                <TextBlock Text="剪贴板捕获开关" Width="130" VerticalAlignment="Center"/>
                <Button x:Name="BtnClipboardHotkey" Width="200" HorizontalAlignment="Right"
                        Click="BtnClipboard_Click"/>
            </DockPanel>

            <!-- 今日速览 -->
            <DockPanel Margin="0,8">
                <TextBlock Text="今日笔记速览" Width="130" VerticalAlignment="Center"/>
                <Button x:Name="BtnQuickViewHotkey" Width="200" HorizontalAlignment="Right"
                        Click="BtnQuickView_Click"/>
            </DockPanel>

            <!-- 沉浸记录 -->
            <DockPanel Margin="0,8">
                <TextBlock Text="沉浸记录" Width="130" VerticalAlignment="Center"/>
                <Button x:Name="BtnVoiceInputHotkey" Width="200" HorizontalAlignment="Right"
                        Click="BtnVoiceInput_Click"/>
            </DockPanel>

            <Button x:Name="BtnResetHotkeys" Content="恢复默认热键"
                    Width="140" HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Click="BtnReset_Click"/>

            <!-- AI 模型 -->
            <TextBlock Text="AI 模型" FontSize="16" FontWeight="Bold"
                       Foreground="#4CAF50" Margin="0,20,0,12"/>

            <DockPanel Margin="0,4">
                <TextBlock Text="API Base URL" Width="130" VerticalAlignment="Center"/>
                <TextBox x:Name="AiBaseUrlInput"
                         Background="#2D2D2D"
                         Foreground="#E0E0E0"
                         BorderBrush="#555555"
                         Padding="6,4"
                         VerticalAlignment="Center"
                         TextChanged="AiBaseUrl_TextChanged"/>
            </DockPanel>

            <DockPanel Margin="0,8">
                <TextBlock Text="API Key（用户自备）" Width="130" VerticalAlignment="Center"/>
                <TextBox x:Name="AiApiKeyInput"
                         Background="#2D2D2D"
                         Foreground="#E0E0E0"
                         BorderBrush="#555555"
                         Padding="6,4"
                         VerticalAlignment="Center"
                         TextChanged="AiApiKey_TextChanged"/>
            </DockPanel>

            <DockPanel Margin="0,8">
                <TextBlock Text="模型名称" Width="130" VerticalAlignment="Center"/>
                <TextBox x:Name="AiModelInput"
                         Background="#2D2D2D"
                         Foreground="#E0E0E0"
                         BorderBrush="#555555"
                         Padding="6,4"
                         VerticalAlignment="Center"
                         TextChanged="AiModel_TextChanged"/>
            </DockPanel>

            <DockPanel Margin="0,12,0,0">
                <Button x:Name="BtnTestAi" Content="测试连接"
                        Width="96" Height="30" HorizontalAlignment="Left"
                        Click="BtnTestAi_Click"/>
                <TextBlock x:Name="AiTestResult"
                           Text=""
                           Foreground="#CCCCCC"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- 分隔线 -->
            <Rectangle Height="1" Fill="#3A3A3A" Margin="0,20,0,0"/>

            <!-- 外观 -->
            <TextBlock Text="外观" FontSize="16" FontWeight="Bold"
                       Foreground="#4CAF50" Margin="0,16,0,12"/>

            <DockPanel Margin="0,4">
                <TextBlock Text="AI 助手名称" Width="130" VerticalAlignment="Center"/>
                <TextBox x:Name="AiAssistantNameInput"
                         Background="#2D2D2D"
                         Foreground="#E0E0E0"
                         BorderBrush="#555555"
                         Padding="6,4"
                         MaxLength="10"
                         VerticalAlignment="Center"
                         TextChanged="AiAssistantName_TextChanged"/>
            </DockPanel>

            <DockPanel Margin="0,8">
                <TextBlock Text="任务栏/托盘图标" Width="130" VerticalAlignment="Center"/>
                <Button x:Name="BtnChooseIcon" Content="选择图标（png/jpg ≤1MB）"
                        Width="180" HorizontalAlignment="Left"
                        Click="BtnChooseIcon_Click"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock x:Name="IconStatusText"
                           Text=""
                           Foreground="#CCCCCC"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnResetIcon" Content="恢复默认图标"
                        Width="110" Height="26"
                        Margin="12,0,0,0"
                        Visibility="Collapsed"
                        Click="BtnResetIcon_Click"/>
            </StackPanel>

            <!-- 分隔线 -->
            <Rectangle Height="1" Fill="#3A3A3A" Margin="0,20,0,0"/>

            <!-- 不透明度 -->
            <TextBlock Text="显示设置" FontSize="16" FontWeight="Bold"
                       Foreground="#4CAF50" Margin="0,16,0,12"/>

            <!-- 输入框不透明度 -->
            <StackPanel Margin="0,4">
                <Grid>
                    <TextBlock Text="输入框不透明度" VerticalAlignment="Center"/>
                    <TextBlock x:Name="InputOpacityLabel" Text="80%"
                               HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="InputOpacitySlider"
                        Minimum="0.3" Maximum="1.0" SmallChange="0.05"
                        Value="0.80"
                        Margin="0,4,0,12"
                        ValueChanged="InputOpacity_Changed"/>
            </StackPanel>

            <!-- 悬浮球不透明度 -->
            <StackPanel Margin="0,4">
                <Grid>
                    <TextBlock Text="悬浮球不透明度" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BallOpacityLabel" Text="85%"
                               HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="BallOpacitySlider"
                        Minimum="0.5" Maximum="1.0" SmallChange="0.05"
                        Value="0.85"
                        Margin="0,4,0,12"
                        ValueChanged="BallOpacity_Changed"/>
            </StackPanel>

            <!-- 速览窗口不透明度 -->
            <StackPanel Margin="0,4">
                <Grid>
                    <TextBlock Text="速览窗口不透明度" VerticalAlignment="Center"/>
                    <TextBlock x:Name="QuickViewOpacityLabel" Text="80%"
                               HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="QuickViewOpacitySlider"
                        Minimum="0.5" Maximum="1.0" SmallChange="0.05"
                        Value="0.80"
                        Margin="0,4,0,12"
                        ValueChanged="QuickViewOpacity_Changed"/>
            </StackPanel>

            <!-- 开机自启 -->
            <CheckBox x:Name="AutoStartCheck"
                      Content="开机自动启动"
                      Foreground="#E0E0E0"
                      Margin="0,8,0,0"
                      Checked="AutoStart_Changed"
                      Unchecked="AutoStart_Changed"/>

            <!-- 存储路径 -->
            <TextBlock Text="笔记存储路径" Margin="0,16,0,4"/>
            <Grid>
                <TextBox x:Name="NotesPathText"
                         Background="#2D2D2D"
                         Foreground="#E0E0E0"
                         BorderBrush="#555555"
                         IsReadOnly="False"
                         Padding="6,4"
                         VerticalAlignment="Center"/>
                <Button Content="浏览"
                        Width="60" HorizontalAlignment="Right"
                        Click="BtnBrowse_Click"/>
            </Grid>

            <!-- 回收站（云同步兜底，QUEST-5 第五步） -->
            <DockPanel Margin="0,14,0,0">
                <TextBlock Text="回收站" Width="130" VerticalAlignment="Center"/>
                <Button x:Name="BtnRecycleBin" Content="打开回收站"
                        Width="120" HorizontalAlignment="Left"
                        Click="BtnRecycleBin_Click"/>
            </DockPanel>

            <!-- 分隔线 -->
            <Rectangle Height="1" Fill="#3A3A3A" Margin="0,20,0,0"/>

            <!-- 云同步（QUEST-5 第八步 + 2026-08-15 方案A 简化：授权码即钥匙，自动解锁） -->
            <TextBlock Text="云同步（坚果云 WebDAV）" FontSize="16" FontWeight="Bold"
                       Foreground="#4CAF50" Margin="0,16,0,12"/>

            <DockPanel Margin="0,4">
                <TextBlock Text="服务器地址" Width="130" VerticalAlignment="Center"/>
                <TextBox x:Name="SyncUrlInput"
                         Background="#2D2D2D" Foreground="#E0E0E0"
                         BorderBrush="#555555" Padding="6,4"
                         VerticalAlignment="Center"/>
            </DockPanel>

            <DockPanel Margin="0,8">
                <TextBlock Text="坚果云账号" Width="130" VerticalAlignment="Center"/>
                <TextBox x:Name="SyncUserInput"
                         Background="#2D2D2D" Foreground="#E0E0E0"
                         BorderBrush="#555555" Padding="6,4"
                         VerticalAlignment="Center"/>
            </DockPanel>

            <DockPanel Margin="0,8">
                <TextBlock Text="授权码" Width="130" VerticalAlignment="Center"/>
                <PasswordBox x:Name="SyncTokenInput"
                             Background="#2D2D2D" Foreground="#E0E0E0"
                             BorderBrush="#555555" Padding="6,4"
                             VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="坚果云网页端『安全-第三方应用管理』生成的应用密码；已保存过可留空沿用（重新填写即更换）"
                       Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

            <DockPanel Margin="0,12,0,0">
                <Button x:Name="BtnSyncConnect" Content="保存并连接"
                        Width="110" Height="30" HorizontalAlignment="Left"
                        Click="BtnSyncConnect_Click"/>
                <Button x:Name="BtnSyncNow" Content="立即同步"
                        Width="90" Height="30" Margin="8,0,0,0"
                        Click="BtnSyncNow_Click"/>
                <Button x:Name="BtnResetSync" Content="重置同步状态"
                        Width="110" Height="30" Margin="8,0,0,0"
                        Click="BtnResetSync_Click"/>
            </DockPanel>

            <CheckBox x:Name="AutoSyncCheck"
                      Content="自动同步（变更后 30 秒合并推送，每 30 分钟轮询拉取）"
                      Foreground="#E0E0E0" Margin="0,10,0,0"
                      Checked="AutoSync_Changed" Unchecked="AutoSync_Changed"/>

            <TextBlock x:Name="SyncStatusText"
                       Text=""
                       Foreground="#CCCCCC" FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

            <!-- 分隔线 -->
            <Rectangle Height="1" Fill="#3A3A3A" Margin="0,20,0,0"/>

            <!-- 待办与提醒（v3.5 QUEST-6） -->
            <TextBlock Text="待办与提醒" FontSize="16" FontWeight="Bold"
                       Foreground="#4CAF50" Margin="0,16,0,12"/>

            <DockPanel Margin="0,4">
                <TextBlock Text="输入框默认类型" Width="130" VerticalAlignment="Center"/>
                <ComboBox x:Name="DefaultTypeCombo" Width="120" HorizontalAlignment="Left"
                          Style="{StaticResource DarkComboBox}"
                          SelectionChanged="DefaultType_SelectionChanged">
                    <ComboBoxItem Content="笔记"/>
                    <ComboBoxItem Content="待办"/>
                </ComboBox>
            </DockPanel>

            <DockPanel Margin="0,8">
                <TextBlock Text="类型切换快捷键" Width="130" VerticalAlignment="Center"/>
                <Button x:Name="BtnTodoSwitchHotkey" Width="200" HorizontalAlignment="Right"
                        Click="BtnTodoSwitch_Click"/>
            </DockPanel>
            <TextBlock Text="在输入框内按快捷键在「笔记/待办」间切换（全局热键，可能与其他应用冲突）"
                       Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

            <DockPanel Margin="0,10,0,0">
                <TextBlock Text="每日汇总弹窗" Width="130" VerticalAlignment="Center"/>
                <CheckBox x:Name="DailySummaryCheck"
                          Content="启用（到点列出所有未办待办）"
                          Foreground="#E0E0E0" VerticalAlignment="Center"
                          Checked="DailySummary_Changed" Unchecked="DailySummary_Changed"/>
            </DockPanel>

            <DockPanel Margin="0,8">
                <TextBlock Text="汇总时间（HH:mm）" Width="130" VerticalAlignment="Center"/>
                <TextBox x:Name="DailySummaryTimeInput" Width="100" HorizontalAlignment="Left"
                         Background="#2D2D2D" Foreground="#E0E0E0"
                         BorderBrush="#555555" Padding="6,4" MaxLength="5"
                         VerticalAlignment="Center"
                         TextChanged="DailySummaryTime_TextChanged"/>
            </DockPanel>
            <TextBlock Text="格式如 18:00（00:00~23:59）；非法输入即时回退原值"
                       Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

            <DockPanel Margin="0,8">
                <TextBlock Text="稍后提醒间隔（分钟）" Width="130" VerticalAlignment="Center"/>
                <TextBox x:Name="SnoozeMinutesInput" Width="100" HorizontalAlignment="Left"
                         Background="#2D2D2D" Foreground="#E0E0E0"
                         BorderBrush="#555555" Padding="6,4"
                         VerticalAlignment="Center"
                         TextChanged="SnoozeMinutes_TextChanged"/>
            </DockPanel>

            <DockPanel Margin="0,8">
                <TextBlock Text="弹窗收起秒数" Width="130" VerticalAlignment="Center"/>
                <TextBox x:Name="PopupCloseSecondsInput" Width="100" HorizontalAlignment="Left"
                         Background="#2D2D2D" Foreground="#E0E0E0"
                         BorderBrush="#555555" Padding="6,4"
                         VerticalAlignment="Center"
                         TextChanged="PopupCloseSeconds_TextChanged"/>
            </DockPanel>

            <DockPanel Margin="0,10,0,0">
                <TextBlock Text="纯日期询问时刻" Width="130" VerticalAlignment="Center"/>
                <CheckBox x:Name="AskTimeCheck"
                          Content="勾选=输入「30号」等纯日期时弹窗问几点；取消=直接默认当天 09:00"
                          Foreground="#E0E0E0" VerticalAlignment="Center"
                          Checked="AskTime_Changed" Unchecked="AskTime_Changed"/>
            </DockPanel>
            <TextBlock Text="只影响只有日期没有具体几点的表达（如「30号」「下周三」「本月30号」）"
                       Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="132,2,0,0"/>

            <!-- 关闭 -->
            <Button Content="关闭"
                    Width="80"
                    IsDefault="True"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
