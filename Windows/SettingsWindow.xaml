<Window x:Class="FocusCapture.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="760" Height="620"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- 深色文本框（板块内通用） -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- v3.5：深色 ComboBox（下拉项高亮绿色） -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <ContentPresenter Margin="6,3" VerticalAlignment="Center"/>
                                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#E0E0E0"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="content"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,4,22,4"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#2D2D2D" BorderBrush="#555555" BorderThickness="1"
                                        CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="Background" Value="#3A3A3A" TargetName="toggle"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧导航列表（深色，选中项绿色左条） -->
        <Style x:Key="NavListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>
        <Style x:Key="NavListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                CornerRadius="0,4,4,0">
                            <ContentPresenter Margin="12,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D2D2D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D2D2D"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 搜索结果项 -->
        <Style x:Key="SearchResultItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter Margin="10,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D2D2D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" MinWidth="150"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════ 左侧：搜索 + 板块导航 ═══════ -->
        <Border Grid.Column="0" Background="#252526" BorderBrush="#3A3A3A" BorderThickness="0,0,1,0">
            <Grid Margin="12,12,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 搜索框（带水印 + 一键清空） -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource DarkTextBox}"
                             Padding="6,4,26,4"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchWatermark"
                               Text="搜索设置…"
                               Foreground="#777777"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                    <Button x:Name="BtnClearSearch"
                            Content="✕"
                            FontSize="11"
                            Width="22" Height="22"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#999999"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,3,0"
                            Visibility="Collapsed"
                            ToolTip="清空搜索"
                            Click="BtnClearSearch_Click"/>
                </Grid>

                <!-- 板块导航（默认显示） -->
                <ListBox x:Name="NavList" Grid.Row="1"
                         Style="{StaticResource NavListBox}"
                         ItemContainerStyle="{StaticResource NavListItem}"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Content="热键"/>
                    <ListBoxItem Content="AI 模型"/>
                    <ListBoxItem Content="外观"/>
                    <ListBoxItem Content="显示"/>
                    <ListBoxItem Content="输入框"/>
                    <ListBoxItem Content="云同步"/>
                    <ListBoxItem Content="待办与提醒"/>
                    <ListBoxItem Content="通用"/>
                </ListBox>

                <!-- 搜索结果（搜索时替换导航） -->
                <Grid Grid.Row="1" x:Name="SearchResultsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SearchCountText"
                               Foreground="#999999" FontSize="11"
                               Margin="2,0,0,6"/>
                    <ListBox x:Name="SearchResults" Grid.Row="1"
                             Style="{StaticResource NavListBox}"
                             ItemContainerStyle="{StaticResource SearchResultItem}"
                             SelectionChanged="SearchResults_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="#E0E0E0"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="#888888" FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════ 分隔条：拖拽调整左右占比 ═══════ -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      Cursor="SizeWE"
                      ShowsPreview="False">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#4CAF50"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <!-- ═══════ 右侧：板块标题 + 内容 + 关闭 ═══════ -->
        <Grid Grid.Column="2" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="24,14">
                <TextBlock x:Name="SectionTitle"
                           Text="热键"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#4CAF50"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="ContentScroller">
                <Grid>
                <!-- ── 板块 0：热键 ── -->
                <StackPanel x:Name="PanelHotkey" Margin="24,18">
                    <DockPanel Margin="0,4">
                        <TextBlock Text="呼出输入框" Width="130" VerticalAlignment="Center"/>
                        <Button x:Name="BtnSummonHotkey" Width="200" HorizontalAlignment="Right"
                                Click="BtnSummon_Click"/>
                    </DockPanel>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="剪贴板捕获开关" Width="130" VerticalAlignment="Center"/>
                        <Button x:Name="BtnClipboardHotkey" Width="200" HorizontalAlignment="Right"
                                Click="BtnClipboard_Click"/>
                    </DockPanel>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="今日笔记速览" Width="130" VerticalAlignment="Center"/>
                        <Button x:Name="BtnQuickViewHotkey" Width="200" HorizontalAlignment="Right"
                                Click="BtnQuickView_Click"/>
                    </DockPanel>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="沉浸记录" Width="130" VerticalAlignment="Center"/>
                        <Button x:Name="BtnVoiceInputHotkey" Width="200" HorizontalAlignment="Right"
                                Click="BtnVoiceInput_Click"/>
                    </DockPanel>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="类型切换快捷键" Width="130" VerticalAlignment="Center"/>
                        <Button x:Name="BtnTodoSwitchHotkey" Width="200" HorizontalAlignment="Right"
                                Click="BtnTodoSwitch_Click"/>
                    </DockPanel>
                    <TextBlock Text="在输入框内按快捷键在「笔记/待办」间切换（全局热键，可能与其他应用冲突）"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="唤出设置面板" Width="130" VerticalAlignment="Center"/>
                        <Button x:Name="BtnSettingsHotkey" Width="200" HorizontalAlignment="Right"
                                Click="BtnSettings_Click"/>
                    </DockPanel>

                    <Button x:Name="BtnResetHotkeys" Content="恢复默认热键"
                            Width="140" HorizontalAlignment="Right"
                            Margin="0,12,0,0"
                            Click="BtnReset_Click"/>
                </StackPanel>

                <!-- ── 板块 1：AI 模型 ── -->
                <StackPanel x:Name="PanelAi" Margin="24,18" Visibility="Collapsed">
                    <DockPanel Margin="0,4">
                        <TextBlock Text="API Base URL" Width="130" VerticalAlignment="Center"/>
                        <TextBox x:Name="AiBaseUrlInput" Style="{StaticResource DarkTextBox}"
                                 TextChanged="AiBaseUrl_TextChanged"/>
                    </DockPanel>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="API Key（用户自备）" Width="130" VerticalAlignment="Center"/>
                        <TextBox x:Name="AiApiKeyInput" Style="{StaticResource DarkTextBox}"
                                 TextChanged="AiApiKey_TextChanged"/>
                    </DockPanel>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="模型名称" Width="130" VerticalAlignment="Center"/>
                        <TextBox x:Name="AiModelInput" Style="{StaticResource DarkTextBox}"
                                 TextChanged="AiModel_TextChanged"/>
                    </DockPanel>

                    <DockPanel Margin="0,12,0,0">
                        <Button x:Name="BtnTestAi" Content="测试连接"
                                Width="96" Height="30" HorizontalAlignment="Left"
                                Click="BtnTestAi_Click"/>
                        <TextBlock x:Name="AiTestResult"
                                   Text=""
                                   Foreground="#CCCCCC"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>

                <!-- ── 板块 2：外观 ── -->
                <StackPanel x:Name="PanelAppearance" Margin="24,18" Visibility="Collapsed">
                    <DockPanel Margin="0,4">
                        <TextBlock Text="AI 助手名称" Width="130" VerticalAlignment="Center"/>
                        <TextBox x:Name="AiAssistantNameInput" Style="{StaticResource DarkTextBox}"
                                 MaxLength="10"
                                 TextChanged="AiAssistantName_TextChanged"/>
                    </DockPanel>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="任务栏/托盘图标" Width="130" VerticalAlignment="Center"/>
                        <Button x:Name="BtnChooseIcon" Content="选择图标（png/jpg ≤1MB）"
                                Width="180" HorizontalAlignment="Left"
                                Click="BtnChooseIcon_Click"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="IconStatusText"
                                   Text=""
                                   Foreground="#CCCCCC"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnResetIcon" Content="恢复默认图标"
                                Width="110" Height="26"
                                Margin="12,0,0,0"
                                Visibility="Collapsed"
                                Click="BtnResetIcon_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- ── 板块 3：显示 ── -->
                <StackPanel x:Name="PanelDisplay" Margin="24,18" Visibility="Collapsed">
                    <StackPanel Margin="0,4">
                        <Grid>
                            <TextBlock Text="输入框不透明度" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InputOpacityLabel" Text="80%"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="InputOpacitySlider"
                                Minimum="0.3" Maximum="1.0" SmallChange="0.05"
                                Value="0.80"
                                Margin="0,4,0,12"
                                ValueChanged="InputOpacity_Changed"/>
                    </StackPanel>

                    <StackPanel Margin="0,4">
                        <Grid>
                            <TextBlock Text="悬浮球不透明度" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BallOpacityLabel" Text="85%"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="BallOpacitySlider"
                                Minimum="0.5" Maximum="1.0" SmallChange="0.05"
                                Value="0.85"
                                Margin="0,4,0,12"
                                ValueChanged="BallOpacity_Changed"/>
                    </StackPanel>

                    <StackPanel Margin="0,4">
                        <Grid>
                            <TextBlock Text="速览窗口不透明度" VerticalAlignment="Center"/>
                            <TextBlock x:Name="QuickViewOpacityLabel" Text="80%"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="QuickViewOpacitySlider"
                                Minimum="0.5" Maximum="1.0" SmallChange="0.05"
                                Value="0.80"
                                Margin="0,4,0,12"
                                ValueChanged="QuickViewOpacity_Changed"/>
                    </StackPanel>
                </StackPanel>

                <!-- ── 板块 4：输入框 ── -->
                <StackPanel x:Name="PanelInput" Margin="24,18" Visibility="Collapsed">
                    <DockPanel Margin="0,4">
                        <TextBlock Text="输入框默认类型" Width="130" VerticalAlignment="Center"/>
                        <ComboBox x:Name="DefaultTypeCombo" Width="120" HorizontalAlignment="Left"
                                  Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="DefaultType_SelectionChanged">
                            <ComboBoxItem Content="笔记"/>
                            <ComboBoxItem Content="待办"/>
                        </ComboBox>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="自动隐藏" Width="130" VerticalAlignment="Center"/>
                        <RadioButton x:Name="AlwaysVisibleRadio"
                                     Content="始终显示"
                                     Foreground="#E0E0E0"
                                     VerticalAlignment="Center"
                                     Checked="AutoHideMode_Changed" Unchecked="AutoHideMode_Changed"/>
                        <RadioButton x:Name="CustomHideRadio"
                                     Content="自定义"
                                     Foreground="#E0E0E0"
                                     VerticalAlignment="Center"
                                     Margin="16,0,0,0"
                                     Checked="AutoHideMode_Changed" Unchecked="AutoHideMode_Changed"/>
                        <TextBox x:Name="AutoHideSecondsInput"
                                 Width="60"
                                 Style="{StaticResource DarkTextBox}"
                                 Margin="8,0,0,0"
                                 TextChanged="AutoHideSeconds_TextChanged"
                                 LostFocus="AutoHideSeconds_LostFocus"/>
                        <TextBlock Text="秒" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="始终显示 = 永不自动隐藏（Esc/保存/快捷键收起）；自定义 = 停止操作 N 秒后隐藏，打字会刷新倒计时（最短 3 秒，不设上限）"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="弹出位置" Width="130" VerticalAlignment="Center"/>
                        <CheckBox x:Name="RememberPositionCheck"
                                  Foreground="#E0E0E0" VerticalAlignment="Center"
                                  Checked="RememberPosition_Changed" Unchecked="RememberPosition_Changed">
                            <TextBlock Text="记住上次位置（输入框可按住空白/边框处拖动）" TextWrapping="Wrap"/>
                        </CheckBox>
                    </DockPanel>
                    <TextBlock Text="勾选后再次唤起时出现在上次拖到的位置（重启应用也生效）；不勾选则每次回到默认位置"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- ── 板块 5：云同步 ── -->
                <StackPanel x:Name="PanelSync" Margin="24,18" Visibility="Collapsed">
                    <TextBlock Text="坚果云 WebDAV" Foreground="#999999" FontSize="11" Margin="0,0,0,6"/>

                    <DockPanel Margin="0,4">
                        <TextBlock Text="服务器地址" Width="130" VerticalAlignment="Center"/>
                        <TextBox x:Name="SyncUrlInput" Style="{StaticResource DarkTextBox}"/>
                    </DockPanel>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="坚果云账号" Width="130" VerticalAlignment="Center"/>
                        <TextBox x:Name="SyncUserInput" Style="{StaticResource DarkTextBox}"/>
                    </DockPanel>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="授权码" Width="130" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="SyncTokenInput"
                                     Background="#2D2D2D" Foreground="#E0E0E0"
                                     BorderBrush="#555555" Padding="6,4"
                                     VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="坚果云网页端『安全-第三方应用管理』生成的应用密码；已保存过可留空沿用（重新填写即更换）"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <DockPanel Margin="0,12,0,0">
                        <Button x:Name="BtnSyncConnect" Content="保存并连接"
                                Width="110" Height="30" HorizontalAlignment="Left"
                                Click="BtnSyncConnect_Click"/>
                        <Button x:Name="BtnSyncNow" Content="立即同步"
                                Width="90" Height="30" Margin="8,0,0,0"
                                Click="BtnSyncNow_Click"/>
                        <Button x:Name="BtnResetSync" Content="重置同步状态"
                                Width="110" Height="30" Margin="8,0,0,0"
                                Click="BtnResetSync_Click"/>
                    </DockPanel>

                    <CheckBox x:Name="AutoSyncCheck"
                              Foreground="#E0E0E0" Margin="0,10,0,0"
                              Checked="AutoSync_Changed" Unchecked="AutoSync_Changed">
                        <TextBlock Text="自动同步（变更后 30 秒合并推送，每 30 分钟轮询拉取）" TextWrapping="Wrap"/>
                    </CheckBox>

                    <TextBlock x:Name="SyncStatusText"
                               Text=""
                               Foreground="#CCCCCC" FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- ── 板块 6：待办与提醒 ── -->
                <StackPanel x:Name="PanelTodo" Margin="24,18" Visibility="Collapsed">
                    <DockPanel Margin="0,4">
                        <TextBlock Text="每日汇总弹窗" Width="130" VerticalAlignment="Center"/>
                        <CheckBox x:Name="DailySummaryCheck"
                                  Foreground="#E0E0E0" VerticalAlignment="Center"
                                  Checked="DailySummary_Changed" Unchecked="DailySummary_Changed">
                            <TextBlock Text="启用（到点列出所有未办待办）" TextWrapping="Wrap"/>
                        </CheckBox>
                    </DockPanel>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="汇总时间（HH:mm）" Width="130" VerticalAlignment="Center"/>
                        <TextBox x:Name="DailySummaryTimeInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource DarkTextBox}" MaxLength="5"
                                 TextChanged="DailySummaryTime_TextChanged"
                                 LostFocus="DailySummaryTime_LostFocus"/>
                    </DockPanel>
                    <TextBlock Text="格式如 18:00（00:00~23:59）；失焦时非法输入回退原值"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="稍后提醒间隔（分钟）" Width="130" VerticalAlignment="Center"/>
                        <TextBox x:Name="SnoozeMinutesInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource DarkTextBox}"
                                 TextChanged="SnoozeMinutes_TextChanged"
                                 LostFocus="SnoozeMinutes_LostFocus"/>
                    </DockPanel>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="弹窗收起秒数" Width="130" VerticalAlignment="Center"/>
                        <TextBox x:Name="PopupCloseSecondsInput" Width="100" HorizontalAlignment="Left"
                                 Style="{StaticResource DarkTextBox}"
                                 TextChanged="PopupCloseSeconds_TextChanged"
                                 LostFocus="PopupCloseSeconds_LostFocus"/>
                    </DockPanel>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="纯日期询问时刻" Width="130" VerticalAlignment="Center"/>
                        <CheckBox x:Name="AskTimeCheck"
                                  Foreground="#E0E0E0" VerticalAlignment="Center"
                                  Checked="AskTime_Changed" Unchecked="AskTime_Changed">
                            <TextBlock Text="勾选=输入「30号」等纯日期时弹窗问几点；取消=直接默认当天 09:00" TextWrapping="Wrap"/>
                        </CheckBox>
                    </DockPanel>
                    <TextBlock Text="只影响只有日期没有具体几点的表达（如「30号」「下周三」「本月30号」）"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="132,2,0,0"/>
                </StackPanel>

                <!-- ── 板块 7：通用 ── -->
                <StackPanel x:Name="PanelGeneral" Margin="24,18" Visibility="Collapsed">
                    <CheckBox x:Name="AutoStartCheck"
                              Content="开机自动启动"
                              Foreground="#E0E0E0"
                              Margin="0,4,0,0"
                              Checked="AutoStart_Changed"
                              Unchecked="AutoStart_Changed"/>

                    <TextBlock Text="笔记存储路径" Margin="0,16,0,4"/>
                    <Grid>
                        <TextBox x:Name="NotesPathText"
                                 Style="{StaticResource DarkTextBox}"
                                 IsReadOnly="False"/>
                        <Button Content="浏览"
                                Width="60" HorizontalAlignment="Right"
                                Click="BtnBrowse_Click"/>
                    </Grid>

                    <DockPanel Margin="0,14,0,0">
                        <TextBlock Text="回收站" Width="130" VerticalAlignment="Center"/>
                        <Button x:Name="BtnRecycleBin" Content="打开回收站"
                                Width="120" HorizontalAlignment="Left"
                                Click="BtnRecycleBin_Click"/>
                    </DockPanel>
                    <TextBlock Text="找回被删除的笔记/待办（云同步时提供兜底）"
                               Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 关闭 -->
            <Border Grid.Row="2" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Padding="24,10">
                <Button Content="关闭"
                        Width="80"
                        IsDefault="True"
                        HorizontalAlignment="Right"
                        Click="BtnClose_Click"/>
            </Border>
        </Grid>
    </Grid>
</Window>
