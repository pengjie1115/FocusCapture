<Window x:Class="FocusCapture.Windows.DueTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置提醒"
        Width="320" Height="170"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Text="提醒时间（yyyy-MM-dd HH:mm）"
                   Foreground="#CCCCCC" Margin="0,0,0,8"/>
        <TextBox x:Name="DueInput"
                 Background="#2D2D2D" Foreground="#E0E0E0"
                 BorderBrush="#555555" Padding="6,4"
                 FontSize="14"
                 PreviewKeyDown="DueInput_PreviewKeyDown"/>
        <TextBlock Text="例：2026-08-28 09:00"
                   Foreground="#666666" FontSize="11" Margin="0,4,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnOk" Content="确定" Width="70"
                    Background="#3A3A3A" Foreground="#4CAF50" BorderBrush="#4CAF50"
                    Click="BtnOk_Click"/>
            <Button Content="取消" Width="70" Margin="8,0,0,0"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>