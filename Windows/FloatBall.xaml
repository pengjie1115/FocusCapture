<Window x:Class="FocusCapture.Windows.FloatBall"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="48" Height="48"
        Background="Transparent"
        Opacity="0.85">

    <Window.Resources>
        <DropShadowEffect x:Key="BallShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
    </Window.Resources>

    <Grid>
        <!-- 收起态：半透明小条 -->
        <Border x:Name="CollapsedBar"
                Width="8" Height="36"
                CornerRadius="4"
                Background="#555555"
                Opacity="0.6"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MouseEnter="CollapsedBar_MouseEnter"
                Cursor="Hand"/>

        <!-- 正常态：圆形悬浮球 -->
        <Grid x:Name="BallGrid">
            <Ellipse x:Name="Ball"
                     Width="40" Height="40"
                     Fill="#3A3A3A"
                     Effect="{StaticResource BallShadow}"
                     Stroke="#555555"
                     StrokeThickness="1"
                     Cursor="Hand"
                     MouseLeftButtonDown="Ball_MouseLeftButtonDown"
                     MouseRightButtonDown="Ball_MouseRightButtonDown"
                     MouseEnter="Ball_MouseEnter"
                     MouseLeave="Ball_MouseLeave"
                     MouseLeftButtonUp="Ball_MouseLeftButtonUp"
                     MouseMove="Ball_MouseMove"/>

            <!-- v3.5：未办待办角标（右上角小圆标，count<=0 隐藏；存在已读暂缓 → 红，否则绿；点击打开汇总窗须吞事件防冒泡触发拖拽/唤出） -->
            <Border x:Name="Badge"
                    MinWidth="18" Height="18"
                    CornerRadius="9"
                    Background="#4CAF50"
                    BorderBrush="#FFFFFF" BorderThickness="1"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-2,-2,0"
                    Padding="4,0"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="Badge_MouseLeftButtonDown">
                <TextBlock x:Name="BadgeText"
                           Text=""
                           Foreground="White"
                           FontSize="10"
                           FontWeight="Bold"
                           TextAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Window>
