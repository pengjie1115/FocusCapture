<Window x:Class="FocusCapture.Windows.FloatBall"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="48" Height="48"
        Background="Transparent"
        Opacity="0.85">

    <Window.Resources>
        <DropShadowEffect x:Key="BallShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
    </Window.Resources>

    <Grid>
        <!-- 收起态：半透明小条 -->
        <Border x:Name="CollapsedBar"
                Width="8" Height="36"
                CornerRadius="4"
                Background="#555555"
                Opacity="0.6"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MouseEnter="CollapsedBar_MouseEnter"
                Cursor="Hand"/>

        <!-- 正常态：圆形悬浮球 -->
        <Grid x:Name="BallGrid">
            <Ellipse x:Name="Ball"
                     Width="40" Height="40"
                     Fill="#3A3A3A"
                     Effect="{StaticResource BallShadow}"
                     Stroke="#555555"
                     StrokeThickness="1"
                     Cursor="Hand"
                     MouseLeftButtonDown="Ball_MouseLeftButtonDown"
                     MouseRightButtonDown="Ball_MouseRightButtonDown"
                     MouseEnter="Ball_MouseEnter"
                     MouseLeave="Ball_MouseLeave"
                     MouseLeftButtonUp="Ball_MouseLeftButtonUp"
                     MouseMove="Ball_MouseMove"/>
        </Grid>
    </Grid>
</Window>
