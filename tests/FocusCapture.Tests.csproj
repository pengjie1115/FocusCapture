<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FocusCapture.Tests</AssemblyName>
    <RootNamespace>FocusCapture.Tests</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
    <!-- 与主项目保持一致：本机 git 使用 reftable 存储后端（extensions.refStorage），
         而 Microsoft.Build.Tasks.Git 不认该扩展会直接报错 —— 禁用 Source Control Manager 查询。
         仅影响 SourceLink 仓库信息生成，不影响构建产物。（主项目 2026-08-15 已同样处理） -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <!-- 只编译显式列出的文件：Program.cs + 下方链接进来的被测源文件 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 刻意不引用主项目：避免把 WPF / NAudio / sherpa.onnx 全部依赖拖进来，编译保持秒级。
         代价：被测类不得依赖项目内其他类，否则编译报错（报错显眼，不会静默出错）。
         将来若要测有内部依赖的模块（如同步引擎），另建一个 ProjectReference 型工程，与本工程共存。

         ★ 下面那份清单同时就是「本层边界」的**机器可读契约**（2026-09-25 物理分层）：
           列进来 = 允许被测；没列 = 本层源码里根本写不出对这个类的引用，编译直接不过。
           原先「真做事」的 6 组（[5]~[10]：剪贴板容错 / 技能目录扫描 / 候选目录 /
           子进程流式读 / 内置技能落地与恢复 / 运行时下载器）连同它们的源文件已整体搬去慢层
           （tests/sync/Program.OutOfScope.cs）。所以下面看不到 SafeClipboard / SkillCatalog /
           SkillManifest / SkillRuntimeLocations / FocusCapturePaths / SkillProcess /
           BuiltinSkills / RuntimeRecipe / RuntimeDownloader 的链接 —— 这不是遗漏，是边界。
           想把它们加回本层，必须同时改本文件（显眼动作），并且会撞上 Program.cs 末尾的
           3 秒墙钟闸门，两道闸都拦。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 主项目通过 GlobalUsings.cs 提供这些命名空间；快层刻意不引主项目，需自己补一份。 -->
    <Using Include="System.Text" />
    <Using Include="System.Text.RegularExpressions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\Services\Sync\CryptoService.cs" Link="Src\CryptoService.cs" />
    <Compile Include="..\Services\TimeParser.cs" Link="Src\TimeParser.cs" />
    <Compile Include="..\Services\QuickViewToolbarCatalog.cs" Link="Src\QuickViewToolbarCatalog.cs" />
    <!-- AI 模型数值输入解析（2026-09-23）：TokenCountParser 刻意零项目依赖（纯字符串→数值，
         不碰配置 / 日志 / WPF），所以能在这层秒级测。它错了的后果全是静默的 ——
         用户照文档抄的 384K 被当非法值丢掉、K 与 M 差 1024 倍算错一个数量级，界面都不报错。 -->
    <Compile Include="..\Services\AI\TokenCountParser.cs" Link="Src\TokenCountParser.cs" />
    <!-- AI 联网层的两个纯函数（2026-09-23）：同样刻意零项目依赖，所以能在秒级这层被测。
         它们错了的后果全是静默的 —— 模型列表少几个（界面不会报错，用户以为供应商只有这么多）、
         把「账户欠费」误报成「稍后重试」（用户能重试到天亮）。 -->
    <Compile Include="..\Services\AI\AiModelListParser.cs" Link="Src\AiModelListParser.cs" />
    <Compile Include="..\Services\AI\AiHealthClassifier.cs" Link="Src\AiHealthClassifier.cs" />
    <!-- 上下文裁剪（2026-09-23）：同样零依赖（刻意不引用 ChatRoles，改用字面量），所以能在这里测。
         它错了的后果最阴：裁剪把「工具调用对」拆散 → 随机 400；估算不留余量 → 偶发超窗；
         图片按字符算 → 完全估不准。这三件都不报错，只在特定长会话里发作。 -->
    <Compile Include="..\Services\AI\ContextBudget.cs" Link="Src\ContextBudget.cs" />
    <!-- 全文搜索的匹配纯函数（2026-09-23）：ChatSearchMatcher 刻意零项目依赖
         （只吃 string、不用 AppLog、不碰配置），所以能在这层秒级测。
         它错了的后果是**静默**的 —— 片段里的换行被压成空格后字符串长度变了，
         若仍用替换前的下标做高亮，界面上的高亮会整体错位，且不报任何错。 -->
    <Compile Include="..\Services\AI\ChatSearchMatcher.cs" Link="Src\ChatSearchMatcher.cs" />
  </ItemGroup>

</Project>
