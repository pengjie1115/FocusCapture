<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FocusCapture.Tests</AssemblyName>
    <RootNamespace>FocusCapture.Tests</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
    <!-- 与主项目保持一致：本机 git 使用 reftable 存储后端（extensions.refStorage），
         而 Microsoft.Build.Tasks.Git 不认该扩展会直接报错 —— 禁用 Source Control Manager 查询。
         仅影响 SourceLink 仓库信息生成，不影响构建产物。（主项目 2026-08-15 已同样处理） -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <!-- 只编译显式列出的文件：Program.cs + 下方链接进来的被测源文件 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 刻意不引用主项目：避免把 WPF / NAudio / sherpa.onnx 全部依赖拖进来，编译保持秒级。
         代价：被测类不得依赖项目内其他类，否则编译报错（报错显眼，不会静默出错）。
         将来若要测有内部依赖的模块（如同步引擎），另建一个 ProjectReference 型工程，与本工程共存。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 主项目通过 GlobalUsings.cs 提供这些命名空间；快层刻意不引主项目，需自己补一份。 -->
    <Using Include="System.Text" />
    <Using Include="System.Text.RegularExpressions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\Services\Sync\CryptoService.cs" Link="Src\CryptoService.cs" />
    <Compile Include="..\Services\TimeParser.cs" Link="Src\TimeParser.cs" />
    <Compile Include="..\Services\QuickViewToolbarCatalog.cs" Link="Src\QuickViewToolbarCatalog.cs" />
    <Compile Include="..\Services\SafeClipboard.cs" Link="Src\SafeClipboard.cs" />
    <!-- Skill 目录扫描与解析（2026-09-20）：这两个文件刻意零项目依赖（根目录由构造注入、
         不用 AppLog），就是为了能在这里直接链接编译 —— 解析是最需要反复测的部分，
         真实 SKILL.md 的写法千奇百怪。执行器（SkillScriptRunner）依赖 AppLog，只能进慢层。 -->
    <Compile Include="..\Services\Skills\SkillCatalog.cs" Link="Src\SkillCatalog.cs" />
    <Compile Include="..\Services\Skills\SkillManifest.cs" Link="Src\SkillManifest.cs" />
  </ItemGroup>

</Project>
