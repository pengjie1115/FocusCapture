<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FocusCapture.Tests</AssemblyName>
    <RootNamespace>FocusCapture.Tests</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
    <!-- 与主项目保持一致：本机 git 使用 reftable 存储后端（extensions.refStorage），
         而 Microsoft.Build.Tasks.Git 不认该扩展会直接报错 —— 禁用 Source Control Manager 查询。
         仅影响 SourceLink 仓库信息生成，不影响构建产物。（主项目 2026-08-15 已同样处理） -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <!-- 只编译显式列出的文件：Program.cs + 下方链接进来的被测源文件 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 刻意不引用主项目：避免把 WPF / NAudio / sherpa.onnx 全部依赖拖进来，编译保持秒级。
         代价：被测类不得依赖项目内其他类，否则编译报错（报错显眼，不会静默出错）。
         将来若要测有内部依赖的模块（如同步引擎），另建一个 ProjectReference 型工程，与本工程共存。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 主项目通过 GlobalUsings.cs 提供这些命名空间；快层刻意不引主项目，需自己补一份。 -->
    <Using Include="System.Text" />
    <Using Include="System.Text.RegularExpressions" />
    <!-- SkillProcess 用 Process/ProcessStartInfo（主项目由 GlobalUsings 提供 System.Diagnostics） -->
    <Using Include="System.Diagnostics" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\Services\Sync\CryptoService.cs" Link="Src\CryptoService.cs" />
    <Compile Include="..\Services\TimeParser.cs" Link="Src\TimeParser.cs" />
    <Compile Include="..\Services\QuickViewToolbarCatalog.cs" Link="Src\QuickViewToolbarCatalog.cs" />
    <Compile Include="..\Services\SafeClipboard.cs" Link="Src\SafeClipboard.cs" />
    <!-- Skill 目录扫描与解析（2026-09-20）：这两个文件刻意零项目依赖（根目录由构造注入、
         不用 AppLog），就是为了能在这里直接链接编译 —— 解析是最需要反复测的部分，
         真实 SKILL.md 的写法千奇百怪。执行器（SkillScriptRunner）依赖 AppLog，只能进慢层。 -->
    <Compile Include="..\Services\Skills\SkillCatalog.cs" Link="Src\SkillCatalog.cs" />
    <Compile Include="..\Services\Skills\SkillManifest.cs" Link="Src\SkillManifest.cs" />
    <!-- 运行时部件的候选目录（2026-09-21）：SkillRuntimeLocations 刻意零项目依赖，
         只依赖数据根 FocusCapturePaths（同样零依赖），所以两个文件都能在这里直接链接。
         顺序错了的后果是静默的 —— 能跑起来、但跑的是旧的那一份，正因如此必须由检查点守。 -->
    <Compile Include="..\Services\Skills\SkillRuntimeLocations.cs" Link="Src\SkillRuntimeLocations.cs" />
    <Compile Include="..\Services\FocusCapturePaths.cs" Link="Src\FocusCapturePaths.cs" />
    <!-- 子进程装配与读取（2026-09-21）：SkillProcess 同样零项目依赖（不用 AppLog、不碰 WPF），
         所以能在这里直接测「流式读 + 超时保留已读」—— 这两条以前没有防线，
         而它们错了的后果是"输出明明出来了却永远读不到"（阻塞命令直接死锁）。 -->
    <Compile Include="..\Services\Skills\SkillProcess.cs" Link="Src\SkillProcess.cs" />
    <!-- 内置 Skill 的落地与恢复（2026-09-21，步骤 4）：BuiltinSkills 同样零项目依赖（目录全由参数注入、
         不用 AppLog），所以能在这里直接测。落地逻辑错了的后果是**静默**的 ——
         用户改过的版本被悄悄覆盖、或者该出现的技能压根没出现，两种都很难被发现。 -->
    <Compile Include="..\Services\Skills\BuiltinSkills.cs" Link="Src\BuiltinSkills.cs" />
    <!-- 运行时按需下载（2026-09-21，步骤 5）：配方与下载器同样刻意零项目依赖
         （日志走注入回调、不引 AppLog），所以能在这里用本地假下载源测。
         它的错法全是"静默"的 —— 下了一半算成功、该删的没删、自检没过也提交，
         正需要"每次改动都跑"的这一层守着。 -->
    <Compile Include="..\Services\Skills\RuntimeRecipe.cs" Link="Src\RuntimeRecipe.cs" />
    <Compile Include="..\Services\Skills\RuntimeDownloader.cs" Link="Src\RuntimeDownloader.cs" />
    <!-- AI 模型数值输入解析（2026-09-23）：TokenCountParser 刻意零项目依赖（纯字符串→数值，
         不碰配置 / 日志 / WPF），所以能在这层秒级测。它错了的后果全是静默的 ——
         用户照文档抄的 384K 被当非法值丢掉、K 与 M 差 1024 倍算错一个数量级，界面都不报错。 -->
    <Compile Include="..\Services\AI\TokenCountParser.cs" Link="Src\TokenCountParser.cs" />
    <!-- AI 联网层的两个纯函数（2026-09-23）：同样刻意零项目依赖，所以能在秒级这层被测。
         它们错了的后果全是静默的 —— 模型列表少几个（界面不会报错，用户以为供应商只有这么多）、
         把「账户欠费」误报成「稍后重试」（用户能重试到天亮）。 -->
    <Compile Include="..\Services\AI\AiModelListParser.cs" Link="Src\AiModelListParser.cs" />
    <Compile Include="..\Services\AI\AiHealthClassifier.cs" Link="Src\AiHealthClassifier.cs" />
  </ItemGroup>

</Project>
